+/* ---- start-up trace: every step goes into the status block and the log ring ---- */
+static void vg_ev(u32 step, u32 rc, u32 val)
+{
+	struct vg_ev *e = &evq[evHead & 127];
+	u32 q;
+	e->step = step; e->rc = rc; e->val = val; e->ms = vg_now_ms(NULL);
+	evHead++;
+	if (!vst) return;
+	q = vst->step_seq++;
+	vst->last_step = step; vst->last_rc = rc; vst->last_val = val;
+	vst->ev[(q & 7) * 3] = (q << 8) | step; vst->ev[(q & 7) * 3 + 1] = rc; vst->ev[(q & 7) * 3 + 2] = val;
+	switch (step) {
+	case ST_NCD_LINK: vst->ncd_rc = rc; break;
+	case ST_KD: vst->kd_rc = rc; vst->kd_out = val; break;
+	case ST_IFSTART: vst->if_rc = rc; break;
+	case ST_GETIF: vst->getif_rc = rc; vst->getif_ip = val; break;
+	case ST_HOSTID: vst->hostid = rc; break;
+	case ST_VARIANT: vst->variant = val; break;
+	default: break;
+	}
+	vg_publish();
+}
