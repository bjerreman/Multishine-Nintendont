+/* ---- EXI hooks (called by EXIUpdateRegistersNEW from the vBBA thread) ---- */
+void VBBAExiSelect(u32 chn, u32 dev)
+{
+	if (V) (void)vbba_ndexi_select(&V->chip, &V->nx, chn, dev);
+}
+
+u32 VBBAExiImm(u32 data, u32 len, u32 mode)
+{
+	if (!V) return 0;
+	return vbba_ndexi_imm(&V->chip, &V->nx, data, len, mode);
+}
+
+void VBBAExiDma(u8 *ptr, u32 len, u32 mode)
+{
+	u32 a = (u32)ptr & ~31u, n = round32(((u32)ptr & 31u) + len);
+	if (!V) return;
+	if (mode == 1) sync_before_read((void *)a, n);          /* guest -> chip: see the PowerPC's data */
+	vbba_ndexi_dma(&V->chip, &V->nx, ptr, len, mode);
+	if (mode != 1) sync_after_write((void *)a, n);          /* chip -> guest: publish ours */
+}
