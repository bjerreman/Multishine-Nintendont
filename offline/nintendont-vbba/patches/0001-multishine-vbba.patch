-				ctx->games.scrollX = ctx->games.gamecount - ctx->games.listMax;
-			}
-		} else {
-			ctx->games.posX = 0;
-		}
-
-		clearCheats = true;
-		ctx->redraw = true;
-		ctx->saveSettings = true;
-	}
-
-	if (FPAD_OK(0) && ctx->games.canBeBooted)
