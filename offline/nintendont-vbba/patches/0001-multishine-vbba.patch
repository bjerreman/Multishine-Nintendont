 static u32 SO_Thread = 0;
 static u8 *soqueueheap = NULL;
 static u32 *so_stack;
-static int sockFd, nwcFd;
+int sockFd = -1, nwcFd = -1;	/* Multishine: not static, the vBBA glue (vbba_glue.c) reuses these two IOS handles */
 static int ourCurrentIP;
 
 static u32 SOCKAlarm()
diff --git a/kernel/vbba_glue.c b/kernel/vbba_glue.c
new file mode 100644
index 0000000..73be04b
--- /dev/null
+++ b/kernel/vbba_glue.c
@@ -0,0 +1,1751 @@
+/*
+
+Nintendont (Kernel) - Multishine virtual BBA glue (prototype, never run on a Wii yet)
+
+Part of a patch set against FIX94/Nintendont bbc0a20; this file is licensed like Nintendont:
+
+This program is free software; you can redistribute it and/or
+modify it under the terms of the GNU General Public License
+as published by the Free Software Foundation version 2.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+It connects the Multishine virtual BBA (offline/nintendont-vbba in the Multishine repository: vbba_chip, vbba_router,
+vbba_ndexi, vbba_tp_ios; built into this kernel from that tree, see the Makefile change) to Nintendont:
+  - EXI channel 0 device 2 is answered by an MX98728 model (EXI.c calls VBBAExiSelect/Imm/Dma instead of the Triforce
+    baseboard handler while the thread runs);
+  - a dedicated "fast EXI" thread (VBBAThread, priority 0x70, above the main loop at 0x50, below the DI/socket/HID
+    threads at 0x78) takes over EXI service completely (EXIServiceStep in EXI.c); it spins on EXI_CMD_0 for a short time
+    after each command and sleeps (udelay) only when idle; the main loop skips EXI while vbbaActive;
+  - the IOS socket layer the transport needs (struct vbba_ios_ops) is implemented with IOS_IoctlAsync/IoctlvAsync on
+    /dev/net/ip/top and /dev/net/kd/request in the conventions kernel/sock.c uses for the BBA hack; completions are
+    collected by a thread that blocks on our own IOS message queue (pattern of SOCKAlarm) and hands them to the vBBA
+    thread through a single-producer/single-consumer ring;
+  - while the main loop writes the memory card image to the SD (GCNCard_Save), the vBBA thread stops serving EXI
+    (VBBAHoldBegin/End), as the single-threaded stock loop did implicitly.
+All vBBA state (chip, router, transport) is touched by the vBBA thread only; the completion thread only writes the
+result of a finished request and one ring entry.
+
+Nothing here has run on a Wii.  The timing constants below are guesses.
+*/
+#include "global.h"
+#include "common.h"
+#include "alloc.h"
+#include "string.h"
+#include "Config.h"
+#include "debug.h"
+#include "EXI.h"
+#include "ff_utf8.h"
+#include "vbba_glue.h"
+
+vu32 vbbaWanted = 0;
+vu32 vbbaActive = 0;
+vu32 vbbaTakeover = 0;      /* 1: the vBBA thread was stalled/cancelled by the watchdog, the main loop serves EXI again (network down) */
+extern bool EXI_IRQ;
+extern bool DI_IRQ;          /* kernel/DI.c: true while an asynchronous disc read may be using FatFs (the SD log is written only when it is false) */
+
+#ifndef VBBA_WITH_CORE
+/* Built without MULTISHINE=...: no vBBA objects, the hooks do nothing (vbbaActive never becomes 1). */
+void VBBAUpdate(void) {}
+void VBBAShutdown(void) {}
+void VBBALazyTouch(void) {}
+void VBBAHoldBegin(void) {}
+void VBBAHoldEnd(void) {}
+void VBBAExiSelect(u32 chn, u32 dev) { (void)chn; (void)dev; }
+u32 VBBAExiImm(u32 data, u32 len, u32 mode) { (void)data; (void)len; (void)mode; return 0; }
+void VBBAExiDma(u8 *ptr, u32 len, u32 mode) { (void)ptr; (void)len; (void)mode; }
+u32 VBBAMainDelay(u32 us) { return us; }
+void VBBAConfigLoad(void) {}
+void VBBAConfigLog(void) {}
+#else
+#ifndef VBBA_OFF
+#define VBBA_OFF 0       /* freeze hunt (b1 diagnostic): bit 1 send/receive counters + latency stamps, 2 duty accounting, 4 kd timing, 8 heartbeat/watchdog extras, 16 publication to 0x131BE000, 32 stack high-water probe (invalidates the live thread stacks!), 64 never start the vBBA, 128 heap + status block in kernel .bss instead of MEM2 0x131xxxxx, 256 b0 transport sources linked (build in a worktree with the old files), 512 b0 sendto timeout (abandon after 3 s) */
+#endif
+#define VG_ON(b) (!(VBBA_OFF & (b)))
+#ifndef VBBA_STEP
+#define VBBA_STEP 9      /* diagnostic builds: 1 counters + 1 KiB status block only, 2 + cfg/baked/auto parse, 3 + send FIFO, 4 + receive order, 5 + main-loop sleep hunk; 9 = all */
+#endif
+#include "vbba_chip.h"
+#include "vbba_router.h"
+#include "vbba_ndexi.h"
+#include "vbba_tp_ios.h"
+
+/* ---- tunables (all guesses until measured on a Wii) ---- */
+#ifndef VBBA_THREAD_PRIO
+#define VBBA_THREAD_PRIO 0x70       /* above the main loop (0x50), below DI / socket / HID threads (0x78); /vbba.cfg can change it (duty 3) */
+#endif
+#ifndef VBBA_SPIN_TICKS
+#define VBBA_SPIN_TICKS 380         /* keep spinning this long after the last command (HW_TIMER 1.898 MHz: ~200 us) */
+#endif
+#ifndef VBBA_BURST_TICKS
+#define VBBA_BURST_TICKS 3800       /* after ~2 ms of continuous service let the main loop run ... */
+#endif
+#ifndef VBBA_YIELD_US
+#define VBBA_YIELD_US 100           /* ... for this long (SI/DI/HID emulation lives in the main loop) */
+#endif
+#ifndef VBBA_IDLE_US
+#define VBBA_IDLE_US 50             /* sleep granularity when idle */
+#endif
+#ifndef VBBA_IOSBUF
+#define VBBA_IOSBUF 0               /* b19: every sendto's datagram, params and vectors are copied into blocks of the stock socket code's IOS heap (soHeap, MEM2 0x13040000, the memory kernel/sock.c hands to /dev/net/ip/top) instead of the vBBA heap */
+#endif
+#ifndef VBBA_SYNCTX
+#define VBBA_SYNCTX 0               /* b20: sendto is a blocking IOS_Ioctlv issued by a dedicated sender thread (libogc's call shape); the thread posts the result to the completion queue */
+#endif
+#ifndef VBBA_ENGSTAT
+#define VBBA_ENGSTAT 0              /* b22a: the periodic "VBBA: tl@" sets (and the shutdown set) also print a read-only snapshot of the PowerPC engine's status blocks (S3 status 64 words, S7 status 48 words) and of what the ARM sees of the PowerPC (pending interrupt words, EXI traffic) */
+#endif
+#ifndef VBBA_SCENESTAT
+#define VBBA_SCENESTAT 0            /* b22b: the same sets also print a few PowerPC game words (scene id, match frame, scene frames, game-end id), the disc (DI) state and the emulated memory card state, to see after a freeze what the game was waiting for */
+#endif
+#ifndef VBBA_MAIN_US
+#define VBBA_MAIN_US 0              /* b17c: build-time default of the main-loop sleep per pass while the vBBA runs (0: the stock 20 us); /vbba.cfg main= still overrides */
+#endif
+#ifndef VBBA_BG_TICKS
+#define VBBA_BG_TICKS 190           /* background work (frames into the ring, IOS completions): ~100 us */
+#endif
+
+#ifndef VBBA_HEAP_BASE              /* (the host glue test overrides these) */
+/* MEM2 0x131A0000..0x131BE000 is the only region the Wii runs proved free for us (build 5c5ae7b).  Everything we write continuously stays inside it, plus the
+   512-byte status block at 0x131BE000 that 5c5ae7b already wrote.  A 1 KiB block there froze the console (diagnostic: b0 pass, b1 freeze): "free" in mem_map.txt was not proof. */
+#define VBBA_EXT_ADDR 0x131A0000    /* 1 KiB working copy of the status block (words 0..255): words 128..255 are the extension, read by the probe at PPC 0xD31A0200 */
+#define VBBA_HEAP_BASE 0x131A0400
+#define VBBA_HEAP_SIZE 0x1DC00
+#define VBBA_STATUS_ADDR 0x131BE000 /* 512-byte published block, words 0..127 exactly as in 5c5ae7b (PPC uncached 0xD31BE000); word 126 = 'VBXT', word 127 = PPC address of the extension */
+#endif
+#define VBBA_EXT_PPC (0xD0000000u | ((u32)(VBBA_EXT_ADDR) & 0x0FFFFFFFu))
+#ifndef VBBA_TMO_START_MS
+#define VBBA_TMO_START_MS 90000     /* (was 15000): the kd start-up is submitted ONCE and not abandoned/resubmitted while IOS associates (each resubmit stacked another request).  Old note: an IOS start-up / address request that has not come back after this long is abandoned (slot orphaned) */
+#endif
+#ifndef VBBA_TMO_OTHER_MS
+#define VBBA_TMO_OTHER_MS 3000      /* any other IOS request except the receives, which are meant to wait; a sendto is only counted as late here ... */
+#endif
+#ifndef VBBA_TMO_SEND_HARD_MS
+#define VBBA_TMO_SEND_HARD_MS 30000 /* ... and abandoned (network down) only after this long: the Wii's IOS needs 100 to 900 ms per sendto, a Wi-Fi stall may need seconds */
+#endif
+#ifndef VBBA_STALL_TICKS
+#define VBBA_STALL_TICKS 569000u    /* main-thread watchdog: no heartbeat from the fast thread for ~300 ms (HW_TIMER 1.898 MHz) -> take over */
+#endif
+#ifndef VBBA_LIVE_LOG
+#define VBBA_LIVE_LOG 0             /* 1: print the start-up trace to /ndebug.log while the game runs (SD writes stall the main loop; off by default) */
+#endif
+#define VBBA_SLOTS 40               /* IOS request slots: up to VBBA_TP_IOS_TX_INFLIGHT sendto + 2 receives per socket + control */
+#define VBBA_RING 128
+#define VBBA_QSLACK 16              /* spare IOS queue entries (memory = exactly 4 bytes each); not needed since the thread stacks are passed by their top, kept as headroom */
+#define VBBA_STACK 0x2000
+
+/* one in-flight IOS request: message, parameter block and vectors, 32-byte aligned in the MEM2 heap */
+struct vg_slot {
+	u32 params[16] __attribute__((aligned(32)));      /* IOS buffers 32-byte aligned like the heap blocks of kernel/sock.c */
+	ioctlv vec[3] __attribute__((aligned(32)));
+	struct ipcmessage msg __attribute__((aligned(32)));
+	struct vbba_ios_req *req;
+	u32 used, stage;
+	s32 result;                 /* written by VBBADoneThread only; the request itself is never touched there */
+	u32 t_ms;                   /* submit time, for the timeout */
+	u32 orphan;                 /* abandoned after a timeout: the late completion only frees the slot */
+	u32 t_tick, done_tick;      /* HW_TIMER at submit (fast thread) and at completion (written by VBBADoneThread): IOS latency of the request */
+	u32 sync;                   /* b20: this sendto goes through the sender thread (its completion message is ours, not IOS's: no mqueue_ack) */
+	u32 iob;                    /* b19: this sendto was submitted from the soHeap blocks (only one such sendto at a time) */
+	u32 kind, late;             /* the operation (also valid when the request was abandoned), a sendto already counted as late */
+} __attribute__((aligned(32)));
+
+struct vg_status {
+	u32 magic, version, flags, loops;
+	u32 cmds, selects, imm, dma, imm3, dma_bytes;
+	u32 tx_frames, rx_frames, tx_udp, rx_dgrams, tx_denied;
