+/* called from the main loop while vbbaWanted; starts the vBBA thread once */
+void VBBALazyTouch(void)
+{
+#if VBBA_LAZY
+	if (!vgStarted && vbbaWanted && !vgStartFailed && !vbbaActive) {
+		dbgprintf("VBBA: lazy: guest touched the BBA at %u ms\r\n", (read32(HW_TIMER) - vgLazyT0) / 1898u);
+		vg_start();
+	}
+#endif
+}
+
+#if VBBA_DIAG
+/* DIAG lines (main thread only, rate limited): the guest has sent no EXI command for 5 s, or an SD command has been in flight for 3 s.
+   L1 exi: cmds served so far, 'blocked' = passes that found the fake EXI interrupt still pending, irq/cause/age = pending interrupt state and its age, int = EXI interrupt word, sel = selected device per channel (ch0 ch1 ch2).
+   L2 card: size, chg (1 = data changed, 2 = system area changed), current/low/high modified offsets, write count; sd = commands, longest ms, ms since the last one ended; hold = card save in progress.
+   L3-6 ev: the last 16 EXI commands newest last: '-ms ago kind/command word/data word dDevice' (kind 10 select, 11 immediate, 12 DMA).  L7: words of the game (scene state) that move while it runs. */
+#define VG_DG(a) (*(const volatile u32 *)((a) & 0x01FFFFFFu))
+static void vg_diag_dump(u32 idle_s, u32 sd_busy_ms)
+{
+	u32 t = read32(HW_TIMER), st[10], cd[6], k, n = EXIDiagCount();
+	char ev[16][40];
+	EXIDiagState(st); GCNCard_DiagState(cd);
+	dbgprintf("DIAG: guest idle %u s, sd busy %u ms | exi: cmds %u blocked %u irq %u cause %u/%u/%u age %u ms int %08X sel %06X timing %u\r\n", idle_s, sd_busy_ms, st[6], st[7], st[0], st[1], st[2], st[3], st[4], st[5], st[8], st[9]);
+	dbgprintf("DIAG: card size %u chg %u off %X low %X high %X wr %u | sd ops %u max %u ms last end %u ms ago | hold %u takeover %u\r\n", cd[0], cd[1], cd[2], cd[3], cd[4], cd[5], vbbaSdOps, vbbaSdMaxTicks / 1898u, (t - vbbaSdLastEnd) / 1898u, (u32)vgHold, (u32)vbbaTakeover);
+	for (k = 0; k < 16u; k++) { if (k < n) EXIDiagEvent(15u - k, t, ev[k]); else ev[k][0] = 0; }
+	for (k = 0; k < 16u; k += 4u) dbgprintf("DIAG: ev %s | %s | %s | %s\r\n", ev[k], ev[k + 1], ev[k + 2], ev[k + 3]);
+	sync_before_read((void *)(0x8046B6A0u & 0x01FFFFFFu), 0x40);
+	dbgprintf("DIAG: guest 80479D30=%08X 8046B6A8=%08X 8046B6A0=%08X 8046B6C4=%08X\r\n", VG_DG(0x80479D30u), VG_DG(0x8046B6A8u), VG_DG(0x8046B6A0u), VG_DG(0x8046B6C4u));
+}
+#endif
