+static void vg_jc(u32 after, u32 job, u32 rc)
+{
+#if VBBA_CRUMBS
+	if (job >= 100u && !after) vgPollN++;
+	if (job >= 100u && vgPollN != 1u && (vgPollN % 20u) != 0u) return;
+	if ((u32)(crHead - crTail) >= 32u) return;
+	crq[crHead & 31u].job = job; crq[crHead & 31u].rc = rc; crq[crHead & 31u].ms = vg_now_ms(NULL); crq[crHead & 31u].after = after;
+	crHead++;
+#else
+	(void)after; (void)job; (void)rc;
+#endif
+}
+static void vg_jc_drain(void)
+{
+	static const char *const jn[] = { "ncd linkstatus", "kd startup", "so_startinterface", "getinterfaceopt", "gethostid" };
+	while (crTail != crHead) {
+		struct vg_cr c = crq[crTail & 31u];
+		u32 k = c.job >= 100u ? c.job - 97u : c.job;
+		crTail++;
+		if (c.after) dbgprintf("VBBA: ios: %s submitted rc %d [%u ms]\r\n", k < 5u ? jn[k] : "?", (int)c.rc, c.ms);
+		else dbgprintf("VBBA: ios: submit %s ... [%u ms]\r\n", k < 5u ? jn[k] : "?", c.ms);
+	}
+}
+
+/* repeated results (IP polling every 250 ms) are logged when they change, and at most every 5 s otherwise */
+static void vg_ev_change(u32 step, u32 rc, u32 val)
+{
+	static u32 lrc[16], lval[16], lms[16], seen[16];
+	u32 now = vg_now_ms(NULL);
+	if (seen[step] && lrc[step] == rc && lval[step] == val && (u32)(now - lms[step]) < 5000u) return;
+	seen[step] = 1; lrc[step] = rc; lval[step] = val; lms[step] = now;
+	vg_ev(step, rc, val);
+}
+
+/* The start-up sequence.  Variants are tried in the order vg_order (1, 0, 2) and rotate on every attempt, so a log shows which one worked:
+     variant 1 (what the first Wii run did): kd/request 6 -> ip/top 0x1F
+     variant 0 (libogc order, net_init_chain in libogc 1.8.23): ncd GetLinkStatus (ioctlv 7, ":d" 32 bytes; -6 = not linked yet)
+               -> kd/request ioctl 6 NWC24 startup (out word: -29 retry, -15 accepted by libogc) -> ip/top 0x1F
+     variant 2: ip/top 0x1F alone
+   then the address is polled with getinterfaceopt(0x4003) and with SO_GETHOSTID (ioctl 0x10, result = address).
+   Order: the Wii runs 3 to 7 (Nintendont-VBBA, one Wii) got the address through variant 1 every time; variant 0 ran first and carried the
+   long first kd call.  The kd/request start-up call itself takes ~20 s on that Wii (20.25 s, 20.34 s, 26.2 s in the three runs with no
+   timeout; the call of variant 1 queued behind an abandoned one returns at the same moment, ~20.8 s, once the first finished), so the
+   order does not shorten the wait for the address; it only makes the first attempt the shortest sequence that has worked. */
+static const u8 vg_order[3] = { 0, 0, 0 };      /* always ncd link status first (gate), then kd start-up, then so_startinterface */
+static u32 vg_first_stage(u32 v) { return v == 0 ? STG_NCD : v == 1 ? STG_KD : STG_IF; }
+static u32 vg_next_stage(u32 v, u32 st) { (void)v; return st == STG_NCD ? STG_KD : st == STG_KD ? STG_IF : STG_DONE; }
+
+static int vg_stage_run(struct vg_slot *s, u32 st)       /* runs on the helper thread only */
+{
+	int rc = -1;
+	s->stage = st; s->t_ms = vg_now_ms(NULL);
+	s->msg.seek.origin = (int)(s - slots);
+	memset(s->params, 0, sizeof(s->params));
+	memset(s->vec, 0, sizeof(s->vec));
+	if (st == STG_NCD) {
+		if (ncdFd < 0) return -1;                   /* opened by the main thread (vg_reopen); no blocking open here */
+		s->vec[0].data = &s->params[8]; s->vec[0].len = 32;
+		sync_after_write(s, sizeof(*s));
+		vg_jc(0, STG_NCD, 0);
+		rc = IOS_IoctlvAsync(ncdFd, 7, 0, 1, s->vec, vgQueue, &s->msg);
+		vg_jc(1, STG_NCD, (u32)rc);
+	} else if (st == STG_KD) {
+		s->params[0] = (u32)-1;
+		sync_after_write(s, sizeof(*s));
+		vg_jc(0, STG_KD, 0);
+		rc = IOS_IoctlAsync(kdFd, 6, NULL, 0, s->params, 0x20, vgQueue, &s->msg);
+		vg_jc(1, STG_KD, (u32)rc);
+		(void)0;      /* nwc_startup of kernel/sock.c */
+		if (VG_ON(4) && rc >= 0 && !(vst->kd_flags & 1)) { vst->kd_submit_ms = s->t_ms; vst->kd_flags |= 1; }
+	} else if (st == STG_IF) {
+		sync_after_write(s, sizeof(*s));
+		vg_jc(0, STG_IF, 0);
+		rc = IOS_IoctlAsync(ipFd, 0x1F, NULL, 0, NULL, 0, vgQueue, &s->msg);
+		vg_jc(1, STG_IF, (u32)rc);          /* so_startinterface */
+	}
+	return rc;
+}
+
+/* hand a start-up step (stage st, or VG_JOB_*) to the helper thread; returns at once.  The slot's stage and timestamp are set here so the timeouts count from now. */
+static int vg_post(struct vg_slot *s, u32 job)
+{
+	if (vgNetQueue < 0) return -1;
+	s->msg.seek.origin = (int)(s - slots);
+	s->sync = 0;
+	return mqueue_send_now(vgNetQueue, (void *)(u32)((((u32)(s - slots) + 1u) << 8) | job), 0) >= 0 ? 0 : -1;
+}
+static int vg_stage_start(struct vg_slot *s, u32 st)
+{
+	s->stage = st; s->t_ms = vg_now_ms(NULL);
+	return vg_post(s, st);
+}
+/* ---- IOS requests ---- */
+static void vg_tl_code(u32 *code, u32 *cnt, u32 v)
+{
+	int k;
+	for (k = 0; k < 4; k++) if (cnt[k] && code[k] == v) { cnt[k]++; return; }
+	for (k = 0; k < 4; k++) if (!cnt[k]) { code[k] = v; cnt[k] = 1; return; }
+	cnt[3]++;
+}
+static void vg_tl_submit(int op, u32 ticks)        /* time the IOS_Ioctlv*Async call itself took */
+{
+	u32 us = vg_ticks_us(ticks), b = us / 1000u;
+	if (op == VBBA_IOS_SENDTO) {
+		vst->e3_sub_n++; vst->e3_sub_sum_us += us; if (us > vst->e3_sub_max_us) vst->e3_sub_max_us = us;
+		vst->e3_sub_hist[b > 20u ? 20u : b]++;
+	} else {
+		vst->e3_rsub_n++; vst->e3_rsub_sum_us += us; if (us > vst->e3_rsub_max_us) vst->e3_rsub_max_us = us;
+	}
+}
+static void vg_tl_done(int op, u32 lat_us, u32 dwell_us, int result)
+{
+	if (op == VBBA_IOS_SENDTO) {
+		u32 b = lat_us / 2000u;
+		vst->e3_lat_hist[b > 25u ? 25u : b]++;
+		vst->e3_dw_n++; vst->e3_dw_sum_us += dwell_us; if (dwell_us > vst->e3_dw_max_us) vst->e3_dw_max_us = dwell_us;
+		if (result < 0) vg_tl_code(vst->e3_tx_code, vst->e3_tx_cnt, (u32)result);
+	} else if ((op == VBBA_IOS_RECVFROM || op == VBBA_IOS_POLL) && result < 0) vg_tl_code(vst->e3_rx_code, vst->e3_rx_cnt, (u32)result);      /* (b18a: an empty non-blocking recvfrom and a failed poll both land here) */
+}
+
+static int vg_submit(void *ctx, struct vbba_ios_req *r)
+{
+	int i, rc = -1;
+	struct vg_slot *s = NULL;
+	u32 tl0 = read32(HW_TIMER);
+	(void)ctx;
+	if (!vgNetReleased) return -1;      /* the network start-up is deferred (see VBBA_NET_ACT): IOS stays idle while the game loads from the SD */
+	if (vgNetDown || ipFd < 0 || kdFd < 0) return -1;            /* no IOS handle: the transport backs off and retries */
+	for (i = 0; i < VBBA_SLOTS; i++) if (!slots[i].used) { s = &slots[i]; break; }
+	if (s == NULL) { vgSlotFull++; return -1; }
+	memset(s->params, 0, sizeof(s->params));
+	memset(s->vec, 0, sizeof(s->vec));
+	s->used = 1; s->orphan = 0; s->late = 0; s->iob = 0; s->sync = 0; s->kind = (u32)r->op; s->result = 0; s->t_ms = vg_now_ms(NULL);
+	if (VG_ON(1)) { s->t_tick = read32(HW_TIMER); s->done_tick = s->t_tick; }
+	s->req = r;
+	s->stage = 0;
+	s->msg.seek.origin = i;
+	switch (r->op) {
+	case VBBA_IOS_STARTUP: {        /* see the comment at vg_first_stage; later stages are chained in vg_poll */
+		u32 st;
+		if (vgRetrySame) vgRetrySame = false;
+		else { vgCur = vg_order[vgVariant % 3u]; vgVariant++; vgNcdWaits = vgKdWaits = 0; vg_ev(ST_VARIANT, 0, vgCur); }
+		st = vg_first_stage(vgCur);
+		while (st != STG_DONE) {
+			rc = vg_stage_start(s, st);
+			if (rc >= 0) break;
+			vg_ev(ST_ISSUE_FAIL, (u32)rc, st);
+			st = vg_next_stage(vgCur, st);
+		}
+		break; }
+	case VBBA_IOS_GETIP:            /* stage 0: so_getinterfaceopt 0x1C, option 0x4003 (IPv4 address), as sock.c; stage 1 (vg_poll): SO_GETHOSTID */
+		s->params[0] = 0xFFFE; s->params[1] = 0x4003;
+		s->params[8] = 0;                       /* the address lands here */
+		s->params[12] = 4;                      /* option length */
+		rc = vg_post(s, VG_JOB_GETIP);
+		break;
+	case VBBA_IOS_SOCKET:           /* so_socket 0x0F: AF_INET 2, SOCK_DGRAM 2, 0 */
+		s->params[0] = 2; s->params[1] = 2; s->params[2] = 0;
+		sync_after_write(s, sizeof(*s));
+		rc = IOS_IoctlAsync(ipFd, 0x0F, s->params, 12, NULL, 0, vgQueue, &s->msg);
+		break;
+	case VBBA_IOS_BIND:             /* so_bind 0x02: {fd, has_name 1, sockaddr {len 8, AF_INET, port, INADDR_ANY}} */
+		s->params[0] = (u32)r->fd; s->params[1] = 1;
+		s->params[2] = (8u << 24) | (2u << 16) | r->port;
+		s->params[3] = 0;
+		sync_after_write(s, sizeof(*s));
+		rc = IOS_IoctlAsync(ipFd, 0x02, s->params, 36, NULL, 0, vgQueue, &s->msg);
+		break;
+	case VBBA_IOS_SENDTO:           /* so_sendto 0x0D: vec0 data, vec1 {fd, flags, has_dest 1, sockaddr} */
+#if VBBA_IOSBUF
+		if (!vgIoBuf && soHeap >= 0) {
+			vgIoBuf = (u8 *)heap_alloc_aligned(soHeap, VBBA_TP_IOS_BUF, 32);
+			vgIoPar = (u32 *)heap_alloc_aligned(soHeap, 64, 32);
+			vgIoVec = (ioctlv *)heap_alloc_aligned(soHeap, 32, 32);
+			if (!vgIoBuf || !vgIoPar || !vgIoVec) vgIoBuf = NULL;
+		}
+		{
+			int k, busy = 0;
+			for (k = 0; k < VBBA_SLOTS; k++) if (slots[k].used && slots[k].iob) busy = 1;
+			if (vgIoBuf && !busy && r->len <= VBBA_TP_IOS_BUF) {
+				memset(vgIoPar, 0, 64);
+				vgIoPar[0] = (u32)r->fd; vgIoPar[1] = 0; vgIoPar[2] = 1;
+				vgIoPar[3] = (8u << 24) | (2u << 16) | r->port;
+				vgIoPar[4] = r->ip;
+				memcpy(vgIoBuf, r->buf, r->len);
+				vgIoVec[0].data = vgIoBuf; vgIoVec[0].len = r->len;
+				vgIoVec[1].data = vgIoPar; vgIoVec[1].len = 40;
+				sync_after_write(vgIoBuf, round32(r->len));
+				sync_after_write(vgIoPar, 64);
+				sync_after_write(vgIoVec, 32);
+				sync_after_write(s, sizeof(*s));
+				s->iob = 1; vgIoSends++;
+				rc = IOS_IoctlvAsync(ipFd, 0x0D, 2, 0, vgIoVec, vgQueue, &s->msg);
+				break;
+			}
+			vgIoFallback++;
+		}
+#endif
+		s->params[0] = (u32)r->fd; s->params[1] = 0; s->params[2] = 1;
+		s->params[3] = (8u << 24) | (2u << 16) | r->port;
+		s->params[4] = r->ip;
+		s->vec[0].data = r->buf; s->vec[0].len = r->len;
+		s->vec[1].data = s->params; s->vec[1].len = 40;
+		sync_after_write(r->buf, round32(r->len));
+		sync_after_write(s, sizeof(*s));
+#if VBBA_SYNCTX
+		s->sync = 1;
+		rc = vgTxQueue >= 0 ? mqueue_send_now(vgTxQueue, &s->msg, 0) : -1;       /* the sender thread issues the blocking IOS_Ioctlv */
+#else
+		rc = IOS_IoctlvAsync(ipFd, 0x0D, 2, 0, s->vec, vgQueue, &s->msg);
+#endif
+		break;
+	case VBBA_IOS_RECVFROM:         /* so_recvfrom 0x0C: vec0 {fd, flags}, out vec1 buffer, out vec2 sockaddr (len 8) */
+		s->params[0] = (u32)r->fd; s->params[1] = 0;
+		s->params[8] = 8u << 24;
+		s->vec[0].data = s->params;     s->vec[0].len = 8;
+		s->vec[1].data = r->buf;        s->vec[1].len = r->len;
+		s->vec[2].data = &s->params[8]; s->vec[2].len = 8;
+		sync_after_write(s, sizeof(*s));
+		rc = IOS_IoctlvAsync(ipFd, 0x0C, 1, 2, s->vec, vgQueue, &s->msg);
+		break;
+	case VBBA_IOS_NONBLOCK:         /* so_fcntl 0x05: {fd, F_SETFL 4, O_NONBLOCK 4} (the IOS values, as Dolphin's WiiSockMan) */
+		s->params[0] = (u32)r->fd; s->params[1] = 4; s->params[2] = 4;
+		sync_after_write(s, sizeof(*s));
+		rc = IOS_IoctlAsync(ipFd, 0x05, s->params, 12, NULL, 0, vgQueue, &s->msg);
+		break;
+	case VBBA_IOS_POLL:             /* so_poll 0x0B (libogc net_poll, one socket): in = u64 timeout in ms (high word 0; 0 = answer at once), out = the pollsd {fd, events POLLIN 1, revents} (12 bytes, filled in before the call as libogc does) in a cache line of its own */
+		s->params[0] = 0; s->params[1] = 0;
+		s->params[8] = (u32)r->fd; s->params[9] = 1; s->params[10] = 0;
+		sync_after_write(s, sizeof(*s));
+		rc = IOS_IoctlAsync(ipFd, 0x0B, s->params, 8, &s->params[8], 12, vgQueue, &s->msg);
+		break;
+	case VBBA_IOS_CLOSE:            /* so_close 0x03 */
+		s->params[0] = (u32)r->fd;
+		sync_after_write(s, sizeof(*s));
+		rc = IOS_IoctlAsync(ipFd, 0x03, s->params, 4, NULL, 0, vgQueue, &s->msg);
+		break;
+	default:
+		break;
+	}
+	if (r->op == VBBA_IOS_SENDTO || r->op == VBBA_IOS_RECVFROM) vg_tl_submit(r->op, read32(HW_TIMER) - tl0);
+	if (rc < 0) { s->used = 0; vgSubmitFail++; return -1; }
+	return 0;
+}
+
+#if VBBA_SYNCTX
+/* b20: the sender thread.  One sendto at a time (the transport hands over one: inflight1): wait for a slot, call the BLOCKING IOS_Ioctlv exactly as libogc's net_sendto does,
+   time the call, hand the result to the completion thread through its queue (same path as an IOS reply, so latency and error accounting are unchanged). */
+static u32 VBBASendThread(void *arg)
+{
+	struct ipcmessage *msg = NULL;
+	(void)arg;
+	while (1) {
+		mqueue_recv(vgTxQueue, &msg, 0);
+		{
+			struct vg_slot *s = &slots[msg->seek.origin];
+			u32 t0 = read32(HW_TIMER), us, b;
+			s32 rc = IOS_Ioctlv(ipFd, 0x0D, 2, 0, s->vec);
+			us = vg_ticks_us(read32(HW_TIMER) - t0);
+			vgSyN++; vgSySum += us; if (us > vgSyMax) vgSyMax = us;
+			for (b = 0; b < 8 && us >= vgSyEdge[b]; b++) { }
+			vgSyHist[b]++;
+			s->msg.result = rc;
+			mqueue_send_now(vgQueue, &s->msg, 0);
+		}
+	}
+	return 0;
+}
+#endif
+
+/* completion thread: the only blocking receive on our queue (pattern of kernel/sock.c SOCKAlarm) */
+static u32 VBBANetThread(void *arg)
+{
+	struct ipcmessage *m = NULL;
+	(void)arg;
+	while (1) {
+		u32 v, st;
+		struct vg_slot *s;
+		int rc;
+		mqueue_recv(vgNetQueue, &m, 0);
+		v = (u32)m; st = v & 255u; s = &slots[(v >> 8) - 1u];
+		if (st == VG_JOB_GETIP) {
+			s->vec[0].data = &s->params[0];  s->vec[0].len = 8;
+			s->vec[1].data = &s->params[8];  s->vec[1].len = 4;
+			s->vec[2].data = &s->params[12]; s->vec[2].len = 4;
+			sync_after_write(s, sizeof(*s));
+			vg_jc(0, VG_JOB_GETIP, 0);
+			rc = IOS_IoctlvAsync(ipFd, 0x1C, 1, 2, s->vec, vgQueue, &s->msg);
+			vg_jc(1, VG_JOB_GETIP, (u32)rc);
+		} else if (st == VG_JOB_HOSTID) {
+			s->msg.seek.origin = (int)(s - slots);
+			vg_jc(0, VG_JOB_HOSTID, 0);
+			rc = IOS_IoctlAsync(ipFd, 0x10, NULL, 0, NULL, 0, vgQueue, &s->msg);
+			vg_jc(1, VG_JOB_HOSTID, (u32)rc);
+		} else rc = vg_stage_run(s, st);
+		if (rc < 0) {                       /* the submit failed: report it as a failed completion, the poll path handles it like any IOS error */
+			vg_ev(ST_ISSUE_FAIL, (u32)rc, st);
+			s->msg.result = rc; s->sync = 1;
+			mqueue_send_now(vgQueue, &s->msg, 0);
+		}
+	}
+	return 0;
+}
+
+static u32 VBBADoneThread(void *arg)
+{
+	struct ipcmessage *msg = NULL;
+	(void)arg;
+	while (1) {
+		mqueue_recv(vgQueue, &msg, 0);
+		{
+			int i = msg->seek.origin;
+			struct vg_slot *s = &slots[i];
+			if (VG_ON(1)) s->done_tick = read32(HW_TIMER);
+			s->result = (s32)msg->result;
+			if (!s->sync) mqueue_ack(msg, 0);
+			if ((u32)(ringHead - ringTail) >= VBBA_RING) { vgRingOvf++; continue; }     /* cannot happen with 64 slots and a ring of 128; guard (the slot stays busy, the timeout frees it) */
+			ring[ringHead & (VBBA_RING - 1)] = (u8)i;
+			ringHead++;
+		}
+	}
+	return 0;
+}
+
+static int vg_poll(void *ctx, struct vbba_ios_req **done)
+{
+	u32 tnow = vg_now_ms(NULL), ti;
+	(void)ctx;
+	while (ringTail != ringHead) {
+		struct vg_slot *s = &slots[ring[ringTail & (VBBA_RING - 1)]];
+		struct vbba_ios_req *r;
+		ringTail++;
+		if (s->orphan) {
+			if (VG_ON(4) && s->kind == VBBA_IOS_STARTUP && s->stage == STG_KD && !(vst->kd_flags & 4)) { vst->kd_late_ms = tnow; vst->kd_late_dur_ms = tnow - s->t_ms; vst->kd_flags |= 4; vg_ev(ST_KD_LATE, s->result, vst->kd_late_dur_ms); }
+			s->orphan = 0; s->used = 0; if (vgOrphans) vgOrphans--; vst->orphans = vgOrphans; continue;     /* late completion of an abandoned request: free the slot, touch nothing else */
+		}   /* late completion of an abandoned request: free the slot, touch nothing else */
+		r = s->req;
+		r->result = s->result;
+		if (VG_ON(1)) r->lat_us = vg_ticks_us(s->done_tick - s->t_tick); else r->lat_us = 0;                  /* submit -> IOS completion seen by the completion thread */
+		if (VG_ON(1)) r->dwell_us = vg_ticks_us(read32(HW_TIMER) - s->done_tick); else r->dwell_us = 0;        /* completion -> collected here */
+		vg_tl_done(r->op, r->lat_us, r->dwell_us, (int)r->result);
+		if (r->op == VBBA_IOS_STARTUP) {
+			u32 st = s->stage, nx;
+			int res = (int)r->result;
+			vg_inval(s->params, 64);
+			if (st == STG_NCD) {
+				vg_ev(ST_NCD_LINK, (u32)res, s->params[8]);
+				if (res < 0 && ncdFd >= 0 && vgNcdWaits < VBBA_NCD_GATE_MAX) { vgNcdWaits++; vgRetrySame = true; vg_ev(ST_NCD_WAIT, (u32)res, vgNcdWaits); }   /* gate: no kd start-up while ncd reports no link (any error, -6 = not linked): the transport retries this stage every RETRY_MS (1 s), at most VBBA_NCD_GATE_MAX times, then the kd start-up goes out once */
+				else res = 0;                       /* link reported (or no ncd handle, or the gate time is used up): carry on to kd start-up */
+			} else if (st == STG_KD) {
+				vg_ev(ST_KD, (u32)res, s->params[0]);
+				vst->startup_rc = s->params[0];
+				if (VG_ON(4) && !(vst->kd_flags & 2)) { vst->kd_done_ms = tnow; vst->kd1_out = s->params[0]; vst->kd_flags |= 2; }
+				if (res >= 0 && (int)s->params[0] == -29 && vgKdWaits < 20) { vgKdWaits++; vgRetrySame = true; res = -29; vg_ev(ST_KD_WAIT, (u32)res, vgKdWaits); }   /* libogc retries -29; -15 it accepts */
+			} else if (st == STG_IF) {
+				vg_ev(ST_IFSTART, (u32)res, 0);
+			}
+			r->result = res;
+			nx = vg_next_stage(vgCur, st);
+			if (res >= 0 && nx != STG_DONE) {       /* chain the next stage; completion is reported after the last one */
+				int rc = vg_stage_start(s, nx);
+				while (rc < 0 && nx != STG_DONE) { vg_ev(ST_ISSUE_FAIL, (u32)rc, nx); nx = vg_next_stage(vgCur, nx); rc = nx == STG_DONE ? 0 : vg_stage_start(s, nx); }
+				if (nx != STG_DONE) continue;
+			}
+		} else if (r->op == VBBA_IOS_GETIP) {
+			vg_inval(s->params, 64);
+			if (s->stage == 0) {
+				r->ip = s->params[8];
+				vg_ev_change(ST_GETIF, (u32)r->result, r->ip);
+				if (VG_ON(4) && r->ip && !(vst->kd_flags & 8)) { vst->ip_ms = tnow; vst->kd_flags |= 8; }
+				s->stage = 1;                       /* chain SO_GETHOSTID: the result of the ioctl is the address */
+				s->msg.seek.origin = (int)(s - slots);
+				if (vg_post(s, VG_JOB_HOSTID) >= 0) continue;
+			} else if (s->stage == 1) {
+				if ((u32)r->result < 0xFFFF0000u && !r->ip) r->ip = (u32)r->result;      /* 192.x.x.x is negative as an s32; errors are small negatives */
+				if (VG_ON(4) && r->ip && !(vst->kd_flags & 8)) { vst->ip_ms = tnow; vst->kd_flags |= 8; }
+				vg_ev_change(ST_HOSTID, (u32)r->result, (u32)r->result < 0xFFFF0000u ? (u32)r->result : 0);
+				r->result = 0;
+				if (VBBA_IFMAC_ON && r->ip && !vgIfMacTried) {       /* address is up: ask ip/top for the MAC of the interface in use (getinterfaceopt 0x1004), once */
+					vgIfMacTried = true;
+					s->stage = 2;
+					s->params[8] = s->params[9] = 0; s->params[12] = 6;
+					s->params[0] = 0xFFFE; s->params[1] = 0x1004;
+					s->vec[0].data = &s->params[0];  s->vec[0].len = 8;
+					s->vec[1].data = &s->params[8];  s->vec[1].len = 6;
+					s->vec[2].data = &s->params[12]; s->vec[2].len = 4;
+					s->msg.seek.origin = (int)(s - slots);
+					sync_after_write(s, sizeof(*s));
+					if (IOS_IoctlvAsync(ipFd, 0x1C, 1, 2, s->vec, vgQueue, &s->msg) >= 0) continue;
+				}
+			} else {                                    /* stage 2: MAC of the active interface */
+				u8 *m = (u8 *)&s->params[8];
+				s32 mres = r->result;
+				r->result = 0;
+				if (mres >= 0 && (m[0] | m[1] | m[2] | m[3] | m[4] | m[5])) {
+					dbgprintf("VBBA: mac (ip/top) %02X:%02X:%02X:%02X:%02X:%02X\r\n", m[0], m[1], m[2], m[3], m[4], m[5]);
+					/* log only: swapping the chip MAC after the address is up broke UDP on the Wii (lanmac test); the chip keeps the early ncd MAC */
+				} else dbgprintf("VBBA: mac (ip/top) read failed (rc %d); chip keeps the ncd MAC\r\n", mres);
+			}
+		} else if (r->op == VBBA_IOS_POLL) {
+			vg_inval(s->params, 64);
+			if (r->result >= 0) r->result = (r->result > 0 && s->params[10] != 0) ? 1 : 0;      /* 1: something to read (data, or an error / hang-up that the recvfrom will report) */
+		} else if (r->op == VBBA_IOS_RECVFROM && r->result > 0) {
+			u32 n = (u32)r->result > r->len ? r->len : (u32)r->result;
+			vg_inval(r->buf, n);
+			vg_inval(s->params, 64);
+			r->port = (u16)(s->params[8] & 0xFFFF);
+			r->ip = s->params[9];
+		}
+		s->used = 0;
+		r->busy = 0;
+		*done = r;
+		return 1;
+	}
+	/* timeouts: nothing here may wait for IOS for ever (receives are meant to wait and are exempt) */
+	for (ti = 0; ti < VBBA_SLOTS; ti++) {
+		struct vg_slot *s = &slots[ti];
+		struct vbba_ios_req *r;
+		bool ctl;
+		if (!s->used || s->orphan) continue;
+		r = s->req;
+		if (r->op == VBBA_IOS_RECVFROM && !VBBA_TP_RXPOLL) continue;      /* (b18a: poll and recvfrom answer at once; a hung one would stop the strictly sequential pipeline, so they time out like any other request) */
+		ctl = r->op == VBBA_IOS_STARTUP || r->op == VBBA_IOS_GETIP;
+		if (!((VBBA_OFF) & 512) && r->op == VBBA_IOS_SENDTO && !s->late && (u32)(tnow - s->t_ms) > VBBA_TMO_OTHER_MS) {      /* a slow sendto is counted, not abandoned: its buffer is still IOS's, and the Wii needs 100 to 900 ms for one */
+			s->late = 1; vst->ios_late++;
+			vg_ev(ST_TIMEOUT, 0x100u | (u32)r->op, (s->stage << 8) | ti);
+		}
+		if ((u32)(tnow - s->t_ms) <= (!((VBBA_OFF) & 512) && r->op == VBBA_IOS_SENDTO ? VBBA_TMO_SEND_HARD_MS : (ctl && r->op == VBBA_IOS_STARTUP ? (s->stage == STG_NCD ? 5000u : VBBA_TMO_START_MS) : VBBA_TMO_OTHER_MS))) continue;
+		s->orphan = 1; vgOrphans++;
+		vst->ios_timeouts++; vst->orphans = vgOrphans; vst->wd_flags |= 8;
+		vg_ev(ST_TIMEOUT, (u32)r->op, (s->stage << 8) | ti);
+		r->result = -116; r->busy = 0;
+		r->lat_us = (u32)(tnow - s->t_ms) * 1000u; r->dwell_us = 0;      /* a request that timed out counts with the time it was given */
+		if (!ctl || vgOrphans >= 6) { vgNetDown = 1; vst->wd_flags |= 2; vst->wd_trips++; vst->wd_reason = ctl ? 5 : 4; vg_ev(ST_WATCHDOG, vst->wd_reason, vgOrphans); }
+		*done = r;
+		return 1;
+	}
+	return 0;
+}
