+#if !VBBA_OWN_OPEN
+	(void)now; (void)last_tick; (void)tried; (void)ncd_tries; (void)name;
+	return;
+#endif
+	if (vgHeap < 0 || ((ipFd >= 0 && kdFd >= 0) && (ncdFd >= 0 || ncd_tries >= 5))) return;
+	if (tried && (u32)(now - last_tick) < 1898000u) return;
+	tried = true; last_tick = now;
+	name = (char *)heap_alloc_aligned(vgHeap, 32, 32);
+	if (!name) return;
