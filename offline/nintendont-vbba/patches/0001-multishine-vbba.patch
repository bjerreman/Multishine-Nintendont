diff --git a/kernel/EXI.c b/kernel/EXI.c
index 67b7471..164ddd3 100644
--- a/kernel/EXI.c
+++ b/kernel/EXI.c
@@ -30,6 +30,7 @@ Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.
 #include "Config.h"
 #include "debug.h"
 #include "SRAM.h"
+#include "vbba_glue.h"
 
 #include "ff_utf8.h"
 
@@ -197,6 +198,7 @@ void EXIInterrupt(void)
 
 void EXIShutdown(void)
 {
+	VBBAShutdown();	// Multishine: stop the vBBA thread before the card images are written
 	if (TRIGame || !exi_inited)
 	{
 		// Triforce doesn't use the standard EXI CARD interface.
@@ -727,6 +729,10 @@ void EXIUpdateRegistersNEW( void )
 							// Device is present.
 							// TODO: SP1 only for Triforce?
 							ret = 1;
+							// Multishine: channel 0 device 2 is the virtual BBA while its thread runs.
+							if (!vbbaActive) VBBALazyTouch();   // lazy test build only: the first guest select of the BBA starts the vBBA (no-op otherwise)
+							if (vbbaActive)
+								VBBAExiSelect(chn, dev);
 							break;
 
 #ifdef GCNCARD_ENABLE_SLOT_B
@@ -779,6 +785,15 @@ void EXIUpdateRegistersNEW( void )
 						break;
 
 					case EXI_DEV_SP1:
+						if (vbbaActive)
+						{
+							// Multishine: virtual BBA.  Reads come back right-aligned in EXI_CMD_1 (EXIImm.S).
+							u32 vres = VBBAExiImm(data, len, mode);
+							write32( EXI_CMD_1, vres );
+							write32( EXI_CMD_0, 0 );
+							sync_after_write((void*)EXI_BASE, 0x20);
+							break;
+						}
 						EXIDeviceSP1( (u8*)data, len, mode );
 						break;
 
@@ -815,6 +830,14 @@ void EXIUpdateRegistersNEW( void )
 						break;
 
 					case EXI_DEV_SP1:
+						if (vbbaActive)
+						{
+							// Multishine: virtual BBA DMA (cache maintenance inside VBBAExiDma).
+							VBBAExiDma( ptr, len, mode );
+							write32( EXI_CMD_0, 0 );
+							sync_after_write((void*)EXI_BASE, 0x20);
+							break;
+						}
 #ifdef DEBUG_SRAM
 						hexdump( ptr, len );
 #endif
@@ -839,6 +863,31 @@ void EXIUpdateRegistersNEW( void )
 	}
 }
 
+/* ONE lock (exiHolder) serialises all EXI service: the vBBA thread and the main loop both call EXIServiceStep, whoever holds the lock handles the fake EXI interrupt and one command.
+   Before, the thread served everything while the main loop skipped EXI, but the main loop still touched shared state (interrupt block, card context) at the same time. */
+static volatile u32 exiHolder;
+static inline u32 exiSwap( volatile u32 *p, u32 v )
+{
+	u32 r;
+	__asm__ volatile( "swp %0, %1, [%2]" : "=&r"(r) : "r"(v), "r"(p) : "memory" );
+	return r;
+}
+int EXILockTry( void ) { return exiSwap( &exiHolder, 1 ) == 0; }
+void EXIUnlock( void ) { exiHolder = 0; }
+int EXIServiceStep( void )
+{
+	if( !EXILockTry() )
+		return 0;
+	if( EXI_IRQ == true )
+	{
+		if( EXICheckTimer() )
+			EXIInterrupt();
+	}
+	EXIUpdateRegistersNEW();
+	EXIUnlock();
+	return 1;
+}
