diff --git a/kernel/GCNCard.c b/kernel/GCNCard.c
index 5ecd36b..00bdaeb 100644
--- a/kernel/GCNCard.c
+++ b/kernel/GCNCard.c
@@ -40,6 +40,22 @@ static GCNCard_ctx memCard[1] __attribute__((aligned(32)));
 
 #define ARRAY_SIZE(x) (sizeof(x) / sizeof(x[0]))
 
+#if VBBA_SCENESTAT
+// Multishine b22b: read-only view of slot A for the vBBA log lines (kernel/vbba_glue.c, build flag -DVBBA_SCENESTAT=1);
+// the counters and HW_TIMER stamps are only written here and only read by GCNCard_VbbaState.
+static u32 vbCardWrites, vbCardSaves, vbCardWrTick, vbCardSvTick;
+u32 GCNCard_VbbaState(u32 *o)
+{
+	const GCNCard_ctx *c = &memCard[0];
+	o[0] = c->size != 0;
+	o[1] = (c->changed_system || c->BlockOffLow < c->BlockOffHigh) ? 1 : 0;
+	o[2] = c->changed_system ? 1 : 0;
+	o[3] = (c->BlockOffLow < c->BlockOffHigh) ? (c->BlockOffHigh - c->BlockOffLow) : 0;
+	o[4] = vbCardWrites; o[5] = vbCardSaves; o[6] = vbCardWrTick; o[7] = vbCardSvTick;
+	return o[0];
+}
+#endif
+
 static void GCNCard_InitCtx(GCNCard_ctx *ctx)
 {
 	memset(ctx, 0, sizeof(*ctx));
@@ -356,6 +372,9 @@ void GCNCard_Save(void)
 			ctx->BlockOffLow = 0xFFFFFFFF;
 			ctx->BlockOffHigh = 0x00000000;
 			ctx->changed_system = false;
+#if VBBA_SCENESTAT
+			if (slot == 0) { vbCardSaves++; vbCardSvTick = read32(HW_TIMER); }
+#endif
 		}
 	}
 }
@@ -398,6 +417,9 @@ void GCNCard_Write(int slot, const void *data, u32 length)
 		return;
 	GCNCard_ctx *const ctx = &memCard[slot];
 	ctx->changed = true;
+#if VBBA_SCENESTAT
+	if (slot == 0) { vbCardWrites++; vbCardWrTick = read32(HW_TIMER); }
+#endif
 
 	// Is this update entirely within the "system area"?
 	if (ctx->BlockOff < 0xA000 && ctx->BlockOff + length < 0xA000)
