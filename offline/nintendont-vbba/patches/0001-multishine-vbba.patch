+#if VBBA_SCENESTAT
+/* b22b: read-only game / disc / card state for the periodic sets, MAIN THREAD ONLY.  Why: b22a showed the engine alive and the game silent on EXI at 'GAME!'; what was the game doing?
+   * Game words: PowerPC RAM read by the ARM exactly like the engine block (physical = PPC address & 0x01FFFFFF after sync_before_read, 32-byte aligned blocks, never written;
+     the PowerPC data cache may hold newer values: a word can lag the game).  0x80479D30 scene word [major, pending, prev, minor], 0x8046B6C4 match frame, 0x80479D58 scene frames,
+     0x8046B6A8 game-end id, 0x8046B6A0 first word of the VsSceneState controller block.
+   * Disc: the DI registers the PowerPC wrote (shared memory 0x13026000: last command, disc offset, length, DMA address) read like the interrupt words, plus what this pass loop sees of the
+     kernel flag DI_IRQ (an asynchronous disc read is in flight, i.e. FatFs may be busy: the same flag that keeps these lines off the SD card): rises seen, age of the current read,
+     how long ago the last one ended, the longest one seen.  A read shorter than one main-loop pass (1 ms) can be missed by the edge counter; the registers are exact.
+   * Card: kernel/GCNCard.c (patched, same flag) exposes slot A: enabled, unsaved data, write/save counts and the HW_TIMER of the last write and save.  The main loop saves the card
+     only when no disc read is in flight and 3 s after the last change (main.c SaveCard), so 'unsaved' stuck with 'busy now' stuck means the flush waits for the disc.
+   All numbers are ages in ms (-1: never seen). */
+#ifndef VBBA_PPCMEM
+#define VBBA_PPCMEM(a) ((const volatile u32 *)((a) & 0x01FFFFFFu))
+#endif
+#define VG_DI_BASE 0x13026000u
+extern u32 GCNCard_VbbaState(u32 *o);   /* kernel/GCNCard.c: o[0] slot A enabled, [1] unsaved, [2] system area dirty, [3] unsaved bytes, [4] writes, [5] saves, [6] HW_TIMER of the last write, [7] of the last save */
+static u32 vgScG[5], vgScGP[5], vgScGHave, vgScD[8], vgScDP[4], vgScDHave, vgScC[8];
+static u32 vgScDiN, vgScRise, vgScFall, vgScMaxMs, vgScDirty;
+static bool vgScIrq, vgScUn;
+static int vg_sc_age(u32 now, u32 tick) { return tick ? (int)((u32)(now - tick) / 1898u) : -1; }
+/* every main-loop pass: edges of DI_IRQ and the card's unsaved state (plain loads of ARM-owned data, no cache operation) */
+static void vg_sc_track(u32 now)
+{
+	bool irq = DI_IRQ;
+	if (irq != vgScIrq) {
+		if (irq) { vgScDiN++; vgScRise = now ? now : 1u; }
+		else { u32 ms = vgScRise ? (u32)(now - vgScRise) / 1898u : 0; vgScFall = now ? now : 1u; if (ms > vgScMaxMs && ms < 1000000u) vgScMaxMs = ms; }
+		vgScIrq = irq;
+	}
+	(void)GCNCard_VbbaState(vgScC);
+	if (vgScC[1] && !vgScUn) vgScDirty = now ? now : 1u;
+	vgScUn = vgScC[1] != 0;
+}
+static void vg_sc_snap(void)
+{
+	u32 i;
+	for (i = 0; i < 5; i++) vgScGP[i] = vgScG[i];
+	for (i = 0; i < 4; i++) vgScDP[i] = vgScD[i + 2];
+	sync_before_read((void *)VBBA_PPCMEM(0x80479D20u), 0x20);
+	sync_before_read((void *)VBBA_PPCMEM(0x80479D40u), 0x20);
+	sync_before_read((void *)VBBA_PPCMEM(0x8046B6A0u), 0x40);
+	vgScG[0] = VBBA_PPCMEM(0x80479D30u)[0]; vgScG[1] = VBBA_PPCMEM(0x8046B6C4u)[0]; vgScG[2] = VBBA_PPCMEM(0x80479D58u)[0];
+	vgScG[3] = VBBA_PPCMEM(0x8046B6A8u)[0]; vgScG[4] = VBBA_PPCMEM(0x8046B6A0u)[0];
+	sync_before_read((void *)VG_DI_BASE, 0x40);
+	for (i = 0; i < 8; i++) vgScD[i] = read32(VG_DI_BASE + 4u * i);
+	(void)GCNCard_VbbaState(vgScC);
+	vgScGHave = vgScDHave ? 2u : 1u; vgScDHave = 1;     /* 1: first set (no previous values) */
+}
+/* every line < 200 characters at the widest values (tests/check_log_lines.py); j = 0..4 */
+static void vg_sc_line(u32 j, u32 sec)
