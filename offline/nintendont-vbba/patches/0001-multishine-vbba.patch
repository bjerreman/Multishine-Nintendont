+++ b/loader/source/vbba_sweep.h
@@ -0,0 +1,43 @@
+/*
+Nintendont (Loader) - Multishine vBBA duty sweep: the rotation logic, no hardware, no libogc (host-tested).  GPL-2.0, see menu.c.
+
+The "auto" app (apps/Nintendont-VBBA-auto) runs the duty-cycle experiment of the vBBA kernel with a different preset on every launch:
+the order is d0, d4, d5, d3, d2, d1, then back to d0 (it keeps cycling).  A one-line text file /vbba_sweep.txt on the SD card (the game
+device) holds the index of the NEXT preset, 0..5.  The loader reads it when it starts (plan: nothing is written), and writes the next
+index right before the game is handed to the kernel (commit).  Delete the file to start again at d0.
+*/
+#ifndef VBBA_SWEEP_H
+#define VBBA_SWEEP_H
+
+#define VBBA_SWEEP_N 6
+#define VBBA_SWEEP_NOSTATE 1u     /* state file missing or unreadable: the sweep starts at its first preset */
+#define VBBA_SWEEP_WRITEFAIL 2u   /* the state file could not be written: the baseline preset d0 is used, so a stuck sweep cannot repeat a setting unnoticed */
+#define VBBA_SWEEP_CFG 4u         /* /vbba.cfg exists: it decides the setting, the sweep neither applies a preset nor advances */
+
+struct vbba_sweep_io {
+    void *ctx;
+    int (*cfg_exists)(void *ctx);                                  /* 1 if /vbba.cfg exists */
+    int (*read_state)(void *ctx, char *buf, unsigned cap);         /* bytes read, or -1 if the file cannot be read */
+    int (*write_state)(void *ctx, const char *text);               /* 0 = written and flushed */
+};
+
+struct vbba_sweep {
+    unsigned index;      /* position in the sequence used by this launch, 0..5 (shown 1-based) */
+    unsigned duty;       /* preset of that position (before a write failure falls back to d0) */
+    unsigned flags;      /* VBBA_SWEEP_* */
+    int baked;           /* preset handed to the kernel: 0..5, or -1 for none (/vbba.cfg decides) */
+    int committed;
+};
+
+extern const unsigned char vbba_sweep_order[VBBA_SWEEP_N];
+/* text of the state file -> the index, or -1 when it is not a single number 0..5 (surrounding white space is fine) */
+int vbba_sweep_parse(const char *text, int len);
+/* reads the state (and /vbba.cfg): decides the preset of this launch; writes nothing */
+void vbba_sweep_plan(const struct vbba_sweep_io *io, struct vbba_sweep *s);
+/* persists the next index; a failure falls back to d0 (flag WRITEFAIL); does nothing with /vbba.cfg or a second call */
+void vbba_sweep_commit(const struct vbba_sweep_io *io, struct vbba_sweep *s);
+/* "duty 4 (auto 2/6)", plus " no state", " WRITE FAILED" or the /vbba.cfg note */
+void vbba_sweep_title(const struct vbba_sweep *s, char *out, unsigned cap);
+/* word for the kernel (0x92FFFFD0): flags << 16 | position (1-based) << 8 | 6 */
+unsigned vbba_sweep_info(const struct vbba_sweep *s);
+#endif
