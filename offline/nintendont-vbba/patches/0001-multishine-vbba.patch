+static u32 vg_now_ms(void *ctx)
+{
+	u32 raw = read32(HW_TIMER), d = raw - clk.last_raw;
+	(void)ctx;
+	clk.last_raw = raw;
+	/* ms += d * 128 / 243000 (HW_TIMER = 243 MHz / 128), exact across the 32-bit wrap, no 64-bit math */
+	while (d) {
+		u32 chunk = d > 0x00FFFFFFu ? 0x00FFFFFFu : d;
+		u32 t = chunk * 128u + clk.rem;
+		u32 q = t / 243000u;
+		clk.rem = t - q * 243000u;
+		clk.ms += q;
+		d -= chunk;
+	}
+	return clk.ms;
+}
