+void VBBAUpdate(void)
+{
+	static u32 last_tick, last_hb, hb_tick;
+	u32 now = read32(HW_TIMER);
+	if (!vgLazyT0) vgLazyT0 = read32(HW_TIMER) | 1u;
+	if (vgNoStart) return;                              /* freeze hunt c3 (VBBA_OFF 64): linked, hooks present, never started; runtime test so the code is not dropped from the binary */
+#if !VBBA_LAZY
+	if (!vgStarted && vbbaWanted && !vgStartFailed) vg_start();
+#endif
+	if (!vgStarted) return;
+	if (last_tick) {
+		u32 ms = (now - last_tick) / 1898u;
+		if (!vgHold && ms > vst->main_gap_max_ms && ms < 1000000u) vst->main_gap_max_ms = ms;     /* how long the main loop was away (SD writes, IOS calls) */
+	} else { last_hb = vst->heartbeat; hb_tick = now; }
+	last_tick = now;
+	vst->main_beat++; vst->main_tick = now;
+	if (vgHold || vst->heartbeat != last_hb) { last_hb = vst->heartbeat; hb_tick = now; }
+	else if (!VBBA_SINGLE && !vbbaTakeover && (u32)(now - hb_tick) > VBBA_STALL_TICKS) vg_takeover(3);
+	if (vbbaTakeover) (void)vbba_chip_poll(&V->chip, 4);   /* the thread's background work */
+	vg_jc_drain();                                      /* ios breadcrumbs of the helper thread */
+#if VBBA_DIAG
+	{
+		static u32 last_print, slow_print; static bool printed, slow_seen;
+		u32 t = read32(HW_TIMER);
+		if (exiDiagSlowTicks && (!slow_seen || (u32)(t - slow_print) > 3796000u)) {      /* at most one slow-command line per 2 s */
+			dbgprintf("DIAG: slow card cmd: EXI command %08X took %u ms\r\n", exiDiagSlowW0, exiDiagSlowTicks / 1898u);
+			exiDiagSlowTicks = 0; slow_print = t; slow_seen = true;
+		}
+		if (exiDiagCmds) {
+			u32 idle = t - exiDiagLastTick, sdb = vbbaSdBusy ? t - vbbaSdBusy : 0;
+			if (idle > 9490000u || sdb > 5694000u) {
+				if (!printed || (u32)(t - last_print) > 18980000u) { printed = true; last_print = t; vg_diag_dump(idle / 1898000u, sdb / 1898u); }
+			} else printed = false;                 /* the guest talks again: arm the next stall report */
+		}
+	}
+#endif
+#if VBBA_SINGLE
+	if (vbbaActive && !vbbaTakeover) {          /* the fast thread's background work, now on the main loop (under the EXI lock: the chip is also touched by the BBA EXI commands) */
+		static u32 pass;
+		if (EXILockTry()) { (void)vbba_chip_poll(&V->chip, 4); EXIUnlock(); }
+		if ((++pass & 255u) == 0) vg_status_update();
+	}
+#endif
+	if (V && !vgLinkLogged) {              /* the chip reports 'link up' to the guest only once IOS has an address (router be_caps) */
+		struct vbba_frame_caps cc; const struct vbba_frame_backend *fb = vbba_router_backend(&V->router);
+		cc.link_up = 0;
+		if (fb->get_capabilities(fb->context, &cc) == VBBA_OK && cc.link_up) { vgLinkLogged = true; dbgprintf("VBBA: link up signalled to the guest at %u ms\r\n", vg_now_ms(NULL)); }
+	}
+	if (!vgNetReleased) {                  /* decided on the main thread only */
+		static u32 last_ops, last_chg; static bool ops_init;
+		u32 ms = vg_now_ms(NULL) - vgNetT0, ops = vbbaSdOps;      /* seconds since the vBBA started, not the absolute clock */
+		if (!ops_init || ops != last_ops) { ops_init = true; last_ops = ops; last_chg = ms; }
+		if (VBBA_NET_DELAY_S) { if (ms >= (u32)VBBA_NET_DELAY_S * 1000u) { vgNetReleased = true; dbgprintf("VBBA: net start released at %u ms\r\n", ms); } }
+		else if (ms >= (u32)VBBA_NET_CAP_S * 1000u) { vgNetReleased = true; dbgprintf("VBBA: net start released: cap reached at %u ms (SD ops %u)\r\n", ms, ops); }
+		else if (ms >= (u32)VBBA_NET_MIN_S * 1000u && (u32)(ms - last_chg) >= (u32)VBBA_NET_IDLE_S * 1000u) { vgNetReleased = true; dbgprintf("VBBA: net start released: SD idle for %u s at %u ms (SD ops %u)\r\n", (u32)VBBA_NET_IDLE_S, ms, ops); }
+	}
+	vg_reopen();                                        /* missing handles / ncd: blocking opens belong here, not on the fast thread */
+#if VBBA_LIVE_LOG
+	vg_drain();                                         /* start-up trace lines, printed here (main thread) */
+#endif
+#if VBBA_SCENESTAT
+	vg_sc_track(now);                                   /* b22b: DI_IRQ edges and the card's unsaved state, every pass */
+#endif
+	/* b17b: the timeline lines every VBBA_TL_PERIOD_S seconds, so they reach /ndebug.log even when the shutdown block never comes.
+	   One line per main-loop pass (each dbgprintf is one SD write + sync), never while a disc read may be in FatFs (DI_IRQ, the
+	   same rule as GCNCard_Save; FatFs is not reentrant) or during a card-save hold.  The main-loop gap counter skips our own writes. */
+	if (!vgTlInit) { vgTlInit = true; vgTlTick = now; }
+	{ u32 d = (u32)(now - vgTlTick) / 1898u; vgTlTick += d * 1898u; vgTlMs += d; }     /* whole ms (HW_TIMER 1.898 MHz) */
+	if (vgTlK >= VG_TL_LINES && vgTlMs >= vgTlNext) { vgTlK = 0; vgTlNext = vgTlMs + VBBA_TL_PERIOD_MS; vgTlAt = vgTlMs / 1000u; }
+	if (vgTlK < VG_TL_LINES && !DI_IRQ && !vgHold) { vg_tl_line(vgTlK++, vgTlAt); last_tick = read32(HW_TIMER); }
+}
+
+void VBBAShutdown(void)
+{
+	if (!vgStarted) return;
+	vgStarted = false;
+	vgStop = 1;
+	if (vgThread) thread_cancel(vgThread, 0);
+	EXIUnlock();                                        /* the cancelled thread may have held the EXI lock */
+	thread_cancel(vgNetThread, 0);
+	vbbaActive = 0; vbbaTakeover = 0;
+	{   /* nothing may stay pending in IOS when this launch ends: IOS would complete it later into memory the next launch reuses (run18: boot 2 hung after a boot 1 that stopped with the kd start-up
+	       and so_startinterface calls still pending).  Count what is outstanding, close every IOS handle the vBBA uses (the close cancels the pending requests; SOCKShutdown() is never called by the stock
+	       kernel, so the SOCKInit handles leaked), then give the completions up to 1.5 s to arrive (the completion thread is still running). */
+		u32 i, n0 = 0, nk = 0, nn = 0, ni = 0, ng = 0, no = 0, w, left;
+		for (i = 0; i < VBBA_SLOTS; i++) if (slots[i].used) {
+			n0++;
+			if (slots[i].orphan) no++;
+			if (slots[i].kind == VBBA_IOS_STARTUP) { if (slots[i].stage == STG_KD) nk++; else if (slots[i].stage == STG_NCD) nn++; else ni++; }
+			else if (slots[i].kind == VBBA_IOS_GETIP) ng++;
+		}
+		if (ncdFd >= 0) { IOS_Close(ncdFd); ncdFd = -1; }
+		if (ipFd >= 0) { IOS_Close(ipFd); if (ipFd == sockFd) sockFd = -1; ipFd = -1; ipOwn = false; }
+		if (kdFd >= 0) { IOS_Close(kdFd); if (kdFd == nwcFd) nwcFd = -1; kdFd = -1; kdOwn = false; }
+		left = n0;
+		for (w = 0; w < 150u && left; w++) {
+			mdelay(10);
+			while (ringTail != ringHead) { slots[ring[ringTail & (VBBA_RING - 1)]].used = 0; ringTail++; }
+			left = 0;
+			for (i = 0; i < VBBA_SLOTS; i++) if (slots[i].used) left++;
+		}
+		dbgprintf("VBBA: stop: %u requests outstanding (kd start-up %u, ncd link %u, so_startinterface %u, address poll %u, abandoned %u), handles closed, %u still pending after %u ms\r\n", n0, nk, nn, ni, ng, no, left, w * 10u);
+	}
+	thread_cancel(vgDoneThread, 0);
+	vg_status_update();
+	vg_drain();
+	dbgprintf("VBBA: watchdog: heartbeat %u main passes %u main gap max %u ms, run max %u ticks, sleep fails %u\r\n",
+		vst->heartbeat, vst->main_beat, vst->main_gap_max_ms, vst->run_max_ticks, vst->sleep_fail);
+	dbgprintf("VBBA: watchdog: trips %u (reason %u, flags %x), ios timeouts %u, orphans %u\r\n", vst->wd_trips, vst->wd_reason, vst->wd_flags, vst->ios_timeouts, vst->orphans);
+	dbgprintf("VBBA: stopped. selects %u imm %u dma %u (%u B) cmds %u\r\n", vst->selects, vst->imm, vst->dma, vst->dma_bytes, vst->cmds);
+	dbgprintf("VBBA: stopped: tx frames %u rx frames %u udp out %u in %u denied %u | net %u ip %08X startups %u\r\n",
+		vst->tx_frames, vst->rx_frames, vst->tx_udp, vst->rx_dgrams, vst->tx_denied, vst->net, vst->ip, vst->startups);
+	dbgprintf("VBBA: idle sleeps %u (longest %u ticks for a %u us request; HW_TIMER ticks are 0.527 us), longest poll gap %u ticks\r\n",
+		vst->sleeps, vst->sleep_max_ticks, VBBA_IDLE_US, vst->spin_gap_max_ticks);
+	dbgprintf("VBBA: holds %u (longest %u ticks), startup rc %08X\r\n", vst->holds, vst->hold_max_ticks, vst->startup_rc);
+	/* dbgprintf formats into a 256-byte stack buffer without a bound (kernel/vsprintf.c): every line is < 200 characters with all numbers at their widest (tests/check_log_lines.py) */
+	dbgprintf("VBBA: send: no-slot drops %u (refused %u) peak %u/%u in flight %u | err %u rate %u nomap %u | glue full %u fail %u\r\n",
+		vst->x_tx_busy_drop, vst->x_tx_busy_calls, vst->x_tx_peak, (u32)VBBA_TP_IOS_TX, vst->x_tx_inflight, vst->x_tx_err, vst->x_tx_rate, vst->x_tx_nomap, vst->x_slot_full, vst->x_submit_fail);
+	dbgprintf("VBBA: hold: held %u from-hold %u replaced %u other-socket %u opening %u\r\n",
+		vst->x_tx_held, vst->x_tx_hold_sent, vst->x_tx_hold_drop, vst->x_tx_hold_busy, vst->x_tx_opening);
+	dbgprintf("VBBA: sendto latency (submit to IOS completion): n %u avg %u us max %u us\r\n",
+		vst->x_tx_lat_n, vst->x_tx_lat_n ? vst->x_tx_lat_sum_us / vst->x_tx_lat_n : 0, vst->x_tx_lat_max_us);
+	dbgprintf("VBBA: sendto buckets <1ms %u <10 %u <50 %u <100 %u <250 %u <500 %u <1s %u >=1s %u\r\n",
+		vst->x_tx_hist[0], vst->x_tx_hist[1], vst->x_tx_hist[2], vst->x_tx_hist[3], vst->x_tx_hist[4], vst->x_tx_hist[5], vst->x_tx_hist[6], vst->x_tx_hist[7]);
+	{   /* the send timeline, final values: the same lines as during the run (VBBAUpdate), tagged with the last second */
+		u32 k;
+		for (k = 0; k < VG_TL_LINES; k++) vg_tl_line(k, vgTlMs / 1000u);
+	}
+	dbgprintf("VBBA: recv: n %u recvfrom wait max %u us, within 5 ms %u | completed to collected avg %u max %u us | collected to router avg %u max %u ms\r\n",
+		vst->x_rx_n, vst->x_rx_lat_max_us, vst->x_rx_fast_n, vst->x_rx_n ? vst->x_rx_dwell_sum_us / vst->x_rx_n : 0, vst->x_rx_dwell_max_us,
+		vst->x_rx_n ? vst->x_rx_wait_sum_ms / vst->x_rx_n : 0, vst->x_rx_wait_max_ms);
+	dbgprintf("VBBA: recv drops: chip ring full waits %u, chip dropped %u, router dropped %u, completion ring overflows %u\r\n",
+		vst->x_rx_chip_full, vst->x_rx_chip_drop, vst->x_rx_router_drop, vst->x_ring_ovf);
+	dbgprintf("VBBA: dhcp: discovers %u, seen before the address %u, offered late %u, acks %u\r\n", vst->x_dhcp_disc, vst->x_dhcp_wait, vst->x_dhcp_deferred, vst->x_dhcp_ack);
+	dbgprintf("VBBA: send queue: %u buffers, at most %u in IOS, handed to IOS %u, peak queued %u\r\n", vst->q_cap, vst->q_inflight_cap, vst->q_sent, vst->q_peak);
+	dbgprintf("VBBA: send queue: queued now %u, in IOS now %u, sendto later than %u ms %u\r\n", vst->q_now, vst->tx_inflight_now, (u32)VBBA_TMO_OTHER_MS, vst->ios_late);
+	dbgprintf("VBBA: send queue: oldest dropped (buffers full) %u, closed-socket %u, all buffers in IOS %u, refused by IOS %u\r\n",
+		vst->q_drop_old, vst->q_drop_dead, vst->q_nobuf, vst->q_refused);
+	dbgprintf("VBBA: send queue: queue wait n %u avg %u max %u ms\r\n", vst->q_wait_n, vst->q_wait_n ? vst->q_wait_sum_ms / vst->q_wait_n : 0, vst->q_wait_max_ms);
+	dbgprintf("VBBA: recv order: completions behind a younger request %u, datagrams held for an older request %u, handed on after the wait %u\r\n", vst->rx_inv, vst->rx_gated, vst->rx_gate_timeout);
+	dbgprintf("VBBA: stacks: fast thread used %u of %u bytes, completion thread %u of 1024, bottom hit flags %u\r\n", vst->stk_fast_used, (u32)VBBA_STACK, vst->stk_done_used, vst->stk_flags);
+	dbgprintf("VBBA: cfg: /vbba.cfg %s (state %u), duty %u, spin %u us, idle sleep %u us%s, thread priority %02X, main-loop sleep %u us\r\n",
+		(vst->cfg_state & 1) ? "read" : "not found", vst->cfg_state, vst->cfg_duty, vst->cfg_spin_us, vst->cfg_idle_us, vst->cfg_adapt ? " (adaptive)" : "", vst->cfg_prio, vst->cfg_main_us ? vst->cfg_main_us : 20u);
+	dbgprintf("VBBA: kd start-up: submitted %u ms, returned %u ms (%u ms), out %d; abandoned call back at %u ms (%u ms); address at %u ms (flags %x)\r\n",
+		vst->kd_submit_ms, vst->kd_done_ms, (vst->kd_flags & 2) ? vst->kd_done_ms - vst->kd_submit_ms : 0, (int)vst->kd1_out, vst->kd_late_ms, vst->kd_late_dur_ms, vst->ip_ms, vst->kd_flags);
+	{   /* HW_TIMER ticks to ms: /1898 */
+		u32 w = vst->dc_wall / 1898u, sl = vst->dc_sleep / 1898u, sv = vst->dc_serve / 1898u, bg = vst->dc_bg / 1898u, run = w > sl ? w - sl : 0;
+		dbgprintf("VBBA: duty: fast thread awake %u ms of %u ms (%u.%u%%), serving commands %u ms, background %u ms\r\n",
+			run, w, w ? run * 100u / w : 0, w ? (run * 1000u / w) % 10u : 0, sv, bg);
+		dbgprintf("VBBA: duty: asleep %u ms in %u sleeps (asked for %u ms)\r\n", sl, vst->dc_sleeps, vst->dc_sleep_want / 1898u);
+		dbgprintf("VBBA: duty: %u loops, %u spin iterations, %u commands; last second awake %u of %u ms, main loop %u passes\r\n",
+			vst->dc_loops, vst->dc_spin, vst->cmds, vst->win_wall > vst->win_sleep ? (vst->win_wall - vst->win_sleep) / 1898u : 0, vst->win_wall / 1898u, vst->win_main);
+	}
+	if (ncdFd >= 0) { IOS_Close(ncdFd); ncdFd = -1; }
+	if (ipOwn && ipFd >= 0) IOS_Close(ipFd);
+	if (kdOwn && kdFd >= 0) IOS_Close(kdFd);
+	ipFd = kdFd = -1; ipOwn = kdOwn = false;
+	heap_destroy(vgHeap);
+	vgHeap = -1;
+	V = NULL;
+}
+
+void VBBAHoldBegin(void)
+{
+	if (!vgStarted || vbbaTakeover) return;
+	vgHold = 1;
+	{ u32 t0 = read32(HW_TIMER); while (vgBusy && (u32)(read32(HW_TIMER) - t0) < 380000u) udelay(10); }   /* the thread finishes the command it is in, then idles; bounded (200 ms) */
+	vgHoldTicks = read32(HW_TIMER);
+}
+
+u32 VBBAMainDelay(u32 us)
+{
+#if VBBA_SINGLE
+	return (vgStarted && VBBA_SINGLE_US > us) ? (u32)VBBA_SINGLE_US : us;
+#else
+	return ((VBBA_STEP >= 5 || VBBA_MAIN_US) && vgStarted && !vbbaTakeover && vgMainUs > us) ? vgMainUs : us;
+#endif
+}
+
+void VBBAHoldEnd(void)
+{
+	u32 d;
+	if (!vgStarted || vbbaTakeover) { vgHold = 0; return; }
+	d = read32(HW_TIMER) - vgHoldTicks;
+	vst->holds++;
+	if (d > vst->hold_max_ticks) vst->hold_max_ticks = d;
+	vgHold = 0;
+}
+#endif /* VBBA_WITH_CORE */
diff --git a/kernel/vbba_glue.h b/kernel/vbba_glue.h
new file mode 100644
index 0000000..1262e97
--- /dev/null
+++ b/kernel/vbba_glue.h
@@ -0,0 +1,34 @@
+/*
+Nintendont (Kernel) - Multishine virtual BBA glue (prototype, never run on a Wii yet).  GPL-2.0, see vbba_glue.c.
+*/
+#ifndef __VBBA_GLUE_H__
+#define __VBBA_GLUE_H__
+#include "global.h"
+
+/* set by DoPatches (Patch.c): BBA Emulation on, Melee (game ID GALE), no Triforce, EXI patches installed */
+extern vu32 vbbaWanted;
+/* 1 while the vBBA thread owns EXI service (EXIUpdateRegistersNEW and the fake EXI interrupt); the main loop skips both */
+extern vu32 vbbaActive;
+/* 1 after the watchdog cancelled a stalled vBBA thread: the main loop serves EXI again (the chip answers, the network is down) */
+extern vu32 vbbaTakeover;
+
+/* main loop, once per pass: starts the vBBA thread when vbbaWanted */
+void VBBAUpdate(void);
+/* EXIShutdown / Shutdown: stops the thread, prints statistics (idempotent) */
+void VBBAShutdown(void);
+void VBBALazyTouch(void);   /* first guest select of the BBA channel while the vBBA is not running; starts it in the lazy test build, does nothing otherwise */
+/* main loop around GCNCard_Save: the vBBA thread stops serving EXI while the card image is written to the SD */
+void VBBAHoldBegin(void);
+void VBBAHoldEnd(void);
+/* main loop: how long its per-pass sleep should be (us): the stock value, or the /vbba.cfg main=US experiment while the vBBA thread runs */
+u32 VBBAMainDelay(u32 us);
+/* main, once at kernel start right after ConfigInit (before any thread uses FatFs): reads /vbba.cfg, the ARM duty-cycle experiment (see vbba_glue.c) */
+void VBBAConfigLoad(void);
+/* main, right after the "Game path" line (the SD log is on from there): logs the preset in force and the auto sweep position */
+void VBBAConfigLog(void);
+
+/* called by EXIUpdateRegistersNEW (from the vBBA thread) for channel 0, device 2 while vbbaActive */
+void VBBAExiSelect(u32 chn, u32 dev);
+u32 VBBAExiImm(u32 data, u32 len, u32 mode);
+void VBBAExiDma(u8 *ptr, u32 len, u32 mode);
+#endif
