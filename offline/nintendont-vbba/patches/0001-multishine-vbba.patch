+			vgScGHave < 2 ? "first set" : vgScG[0] == vgScGP[0] ? "scene word unchanged" : "SCENE WORD CHANGED", vgScGHave < 2 ? "-" : (vgScG[1] == vgScGP[1] && vgScG[2] == vgScGP[2] && vgScG[3] == vgScGP[3]) ? "game words frozen" : "game words moving"); break;
+	case 2: dbgprintf("VBBA: tl@%u di: DI_IRQ %u hold %u | last cmd %08X off %08X len %08X dma %08X | ctl %08X st %08X | regs %s\r\n", sec, (u32)DI_IRQ, (u32)vgHold, vgScD[2], vgScD[3] << 2, vgScD[4], vgScD[5], vgScD[7], vgScD[0],
