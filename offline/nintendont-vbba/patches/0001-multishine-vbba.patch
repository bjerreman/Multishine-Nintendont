+	case 3: dbgprintf("VBBA: tl@%u di: reads seen %u | busy now %d ms | last ended %d ms ago | longest %u ms\r\n", sec, vgScDiN, DI_IRQ ? vg_sc_age(now, vgScRise) : 0, vg_sc_age(now, vgScFall), vgScMaxMs); break;
+	case 4: dbgprintf("VBBA: tl@%u card: on %u unsaved %u (%u B sys %u) dirty %d ms | writes %u (%d ms ago) | saves %u (%d ms ago)\r\n", sec, vgScC[0], vgScC[1], vgScC[3], vgScC[2],
+			vgScC[1] ? vg_sc_age(now, vgScDirty) : 0, vgScC[4], vg_sc_age(now, vgScC[6]), vgScC[5], vg_sc_age(now, vgScC[7])); break;
+	default: break;
+	}
+}
