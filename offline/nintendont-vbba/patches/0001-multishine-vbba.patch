+/* main thread only: print the queued events (dbgprintf syncs the file each time, so each line is on the card when it returns) */
+static void vg_drain(void)
+{
+	while (evTail != evHead) {
+		struct vg_ev e;
+		if ((u32)(evHead - evTail) > 128u) { dbgprintf("VBBA: log ring overrun, %u events lost\r\n", (u32)(evHead - evTail - 128u)); evTail = evHead - 128u; }
+		e = evq[evTail & 127];
+		evTail++;
+		dbgprintf("VBBA: [%u ms] %s rc %d val %08X\r\n", e.ms, e.step < sizeof(stepname) / sizeof(stepname[0]) ? stepname[e.step] : "?", (int)e.rc, e.val);
+	}
+}
