diff --git a/kernel/vbba_glue.c b/kernel/vbba_glue.c
index 938c5f4..9b64406 100644
--- a/kernel/vbba_glue.c
+++ b/kernel/vbba_glue.c
@@ -333,7 +333,8 @@ static volatile u32 vgNoStart = (VBBA_OFF) & 64;
 static u32 vgAutoWrite, vgCfgState, vgCfgDuty, vgAutoInfo, vgBaked = 0xFFFFFFFFu;                /* what VBBAConfigLoad found (copied into the status block when the vBBA starts) */
 static u32 vgSpinTicks = VBBA_SPIN_TICKS, vgIdleUs = VBBA_IDLE_US, vgPrio = VBBA_THREAD_PRIO, vgAdaptive = 0, vgMainUs = VBBA_MAIN_US;
 static u32 vgCfgPoke, vgPokeAt, vgPokes;      /* experiment switch /vbba.cfg irqpoke=SECONDS (0 = off, default): when the guest has posted no EXI command for N s, throw one spurious EXI transfer-complete interrupt (every 5 s at most): tests the lost-interrupt theory */
-static u32 vgCfgNetDelayS, vgCfgNoBba;   /* test switches from /vbba.cfg: netdelay=SECONDS (net start not before N s after the vBBA started), nobba=1 (the vBBA is never started); both 0 = the behaviour */
+static u32 vgCfgNetDelayS, vgCfgNoBba, vgCfgNetEarly;   /* netearly=SECONDS (1..30) is netdelay with another log text: the net start is released N s after the vBBA started whatever the SD is doing (no SD-idle wait) */
+/* test switches from /vbba.cfg: netdelay=SECONDS (net start not before N s after the vBBA started), nobba=1 (the vBBA is never started); both 0 = the behaviour */
 static u32 dcSleep, dcSleepWant, dcServe, dcBg, dcLoops, dcSpin, dcSleeps, dcT0;
 static u32 vgSleptAt;
 /* log ring: filled by the vBBA thread, printed with dbgprintf by the MAIN thread only (VBBAUpdate/VBBAShutdown); the
@@ -1357,6 +1358,7 @@ void VBBAConfigLoad(void)
 		else if (!strncmp(tok, "prio=", 5)) { prio = vg_num(tok + 5, 16, &ok); hv |= ok ? 4u : 0; }
 		else if (!strncmp(tok, "main=", 5)) { main_us = vg_num(tok + 5, 10, &ok); hv |= ok ? 8u : 0; }
 		else if (!strncmp(tok, "dns=", 4)) { u32 v = vg_ip4(tok + 4, &ok); if (ok) vgDhcpDns = v; }
+		else if (!strncmp(tok, "netearly=", 9)) { u32 v = vg_num(tok + 9, 10, &ok); if (ok && v >= 1u && v <= 30u) { vgCfgNetDelayS = v; vgCfgNetEarly = 1; } else ok = false; }
 		else if (!strncmp(tok, "netdelay=", 9)) { u32 v = vg_num(tok + 9, 10, &ok); if (ok && v <= 600u) vgCfgNetDelayS = v; else ok = false; }
 		else if (!strncmp(tok, "nobba=", 6)) { u32 v = vg_num(tok + 6, 10, &ok); if (ok) vgCfgNoBba = v ? 1u : 0u; }
 		else if (!strncmp(tok, "irqpoke=", 8)) { u32 v = vg_num(tok + 8, 10, &ok); if (ok && v >= 3u && v <= 600u) vgCfgPoke = v; else if (ok && v == 0u) vgCfgPoke = 0; else ok = false; }
@@ -1391,7 +1393,7 @@ u32 VBBANoBba(void) { return vgCfgNoBba; }
 /* the first lines of the run block in /ndebug.log (main.c, right after the "Game path" line; the SD log is on by then): which preset this run uses and why */
 void VBBAConfigLog(void)
 {
-	dbgprintf("VBBA: cfg: netdelay %u s, nobba %u (0 = off, the behaviour)\r\n", vgCfgNetDelayS, vgCfgNoBba);
+	dbgprintf("VBBA: cfg: %s %u s, nobba %u (0 = off, the behaviour)\r\n", vgCfgNetEarly ? "netearly" : "netdelay", vgCfgNetDelayS, vgCfgNoBba);
 	if (vgCfgPoke) dbgprintf("VBBA: cfg: irqpoke %u s (experiment: a spurious EXI TC interrupt after that long a guest silence)\r\n", vgCfgPoke);
 	if (VBBA_STEP < 2) return;
 	dbgprintf("VBBA: duty %u (baked %d%s, /vbba.cfg %s), spin %u ticks, idle %u us%s, priority %02X, main-loop sleep %u us\r\n", vgCfgDuty, vgBaked <= 5u ? (int)vgBaked : -1,
@@ -1523,7 +1525,7 @@ static void vg_start(void)
 	dbgprintf("VBBA: init: setting vbbaActive, releasing the fast thread\r\n");
 	vgNetReleased = !(VBBA_NET_DELAY_S || VBBA_NET_ACT || vgCfgNetDelayS);
 	vgNetT0 = vg_now_ms(NULL);
-	if (vgCfgNetDelayS) dbgprintf("VBBA: net start deferred until %u s after the vBBA start (/vbba.cfg netdelay)\r\n", vgCfgNetDelayS);
+	if (vgCfgNetDelayS) dbgprintf("VBBA: net start %s until %u s after the vBBA start (/vbba.cfg %s)\r\n", vgCfgNetEarly ? "set to start EARLY, not before" : "deferred", vgCfgNetDelayS, vgCfgNetEarly ? "netearly" : "netdelay");
 	else if (VBBA_NET_DELAY_S) dbgprintf("VBBA: net start deferred until %u s\r\n", (u32)VBBA_NET_DELAY_S);
 	else if (VBBA_NET_ACT) dbgprintf("VBBA: net start deferred until the SD is idle for %u s (min %u s, cap %u s)\r\n", (u32)VBBA_NET_IDLE_S, (u32)VBBA_NET_MIN_S, (u32)VBBA_NET_CAP_S);
 	vbbaActive = 1;
@@ -2051,7 +2053,7 @@ void VBBAUpdate(void)
 		static u32 last_ops, last_chg; static bool ops_init;
 		u32 ms = vg_now_ms(NULL) - vgNetT0, ops = vbbaSdOps;      /* seconds since the vBBA started, not the absolute clock */
 		if (!ops_init || ops != last_ops) { ops_init = true; last_ops = ops; last_chg = ms; }
-		if (vgCfgNetDelayS) { if (ms >= vgCfgNetDelayS * 1000u) { vgNetReleased = true; dbgprintf("VBBA: net start released at %u ms (netdelay %u s)\r\n", ms, vgCfgNetDelayS); } }
+		if (vgCfgNetDelayS) { if (ms >= vgCfgNetDelayS * 1000u) { vgNetReleased = true; if (vgCfgNetEarly) dbgprintf("VBBA: net start released EARLY at %u ms (netearly %u s, SD ops %u)\r\n", ms, vgCfgNetDelayS, ops); else dbgprintf("VBBA: net start released at %u ms (netdelay %u s)\r\n", ms, vgCfgNetDelayS); } }
 		else if (VBBA_NET_DELAY_S) { if (ms >= (u32)VBBA_NET_DELAY_S * 1000u) { vgNetReleased = true; dbgprintf("VBBA: net start released at %u ms\r\n", ms); } }
 		else if (ms >= (u32)VBBA_NET_CAP_S * 1000u) { vgNetReleased = true; dbgprintf("VBBA: net start released: cap reached at %u ms (SD ops %u)\r\n", ms, ops); }
 		else if (ms >= (u32)VBBA_NET_MIN_S * 1000u && (u32)(ms - last_chg) >= (u32)VBBA_NET_IDLE_S * 1000u) { vgNetReleased = true; dbgprintf("VBBA: net start released: SD idle for %u s at %u ms (SD ops %u)\r\n", (u32)VBBA_NET_IDLE_S, ms, ops); }
