+#if VBBA_WC24
+static u32 *vgWcOut;                      /* 32 bytes, 32-aligned (heap), allocated by the main thread */
+static volatile s32 vgWcState, vgWcRc;    /* 0 idle, 1 posted, 2 paused, -1 failed; the ioctl's result */
+static volatile u32 vgWcPrev;             /* the answer word: 0 = it was running */
+/* MAIN THREAD: 4 s after the address first appears, hand the pause to the helper thread (once); log its outcome when it is back. */
+static void vg_wc24(void)
+{
+	static u32 t0, logged;
+	u32 now;
+	if (!vgGotIp || vgHeap < 0 || vgNetQueue < 0 || logged) return;
+	now = vg_now_ms(NULL);
+	if (vgWcState == 0) {
+		if (!t0) { t0 = now | 1u; return; }
+		if ((s32)(now - t0) < 4000) return;
+		vgWcOut = (u32 *)heap_alloc_aligned(vgHeap, 32, 32);
+		if (!vgWcOut) { logged = 1; dbgprintf("VBBA: wc24: out of memory\r\n"); return; }
+		vgWcState = 1;
+		if (mqueue_send_now(vgNetQueue, (void *)((1u << 8) | VG_JOB_WC24), 0) < 0) { vgWcState = -1; logged = 1; dbgprintf("VBBA: wc24: could not post\r\n"); }
+		return;
+	}
+	if (vgWcState == 1) { if ((s32)(now - t0) > 60000) { logged = 1; dbgprintf("VBBA: wc24: still waiting after 60 s\r\n"); } return; }
+	logged = 1;
+	dbgprintf("VBBA: wc24: %s rc %d (previous %d: %s)\r\n", vgWcState == 2 ? "suspended" : "suspend FAILED", (int)vgWcRc, (int)vgWcPrev, vgWcPrev == 0 ? "it was running" : "it was paused already");
+}
+/* GAME EXIT (vgGameLogBegin) and SHUTDOWN: the scheduler as it was (only after our own pause went through; a pause still pending is cancelled by the
+   handle close).  Runs once: the first caller resumes, later calls find state 3. */
+static s32 vgWcResRc = 1;                 /* 1 = not resumed (yet) */
+static void vg_wc24_resume(void)
+{
+	if (vgWcState != 2 || kdFd < 0 || !vgWcOut || vgWcPrev != 0) return;     /* paused already before us: leave it paused */
+	vgWcOut[0] = 0; sync_after_write(vgWcOut, 32);
+	vgWcResRc = IOS_Ioctl(kdFd, 3, NULL, 0, vgWcOut, 32);
+	vgWcState = 3;
+	dbgprintf("VBBA: wc24: resumed rc %d\r\n", (int)vgWcResRc);
+}
+/* one summary block for /multishine/game.log (sdumpf tees into it), called by vgGameLogBegin; resumes WiiConnect24 first (game exit) */
+void VBBAWifiGameLog(void)
+{
+	extern int sdumpf(const char *fmt, ...);
+#if VBBA_ROAM
+	if (vgRoamWas < 0) sdumpf("GAMELOG: roam: not set (interface kind %u: 1 = Wi-Fi; first read rc %d)\r\n", vgCfgKind, (int)vgRoamRc);
+	else sdumpf("GAMELOG: roam: was %s, set off rc %d, now %s, %u set(s) in this run\r\n", vgRoamWas ? "off" : "on", (int)vgRoamRc, vgRoamNow ? "OFF" : "still ON", vgRoamSets);
+#endif
+	if (vgWcState == 2 || vgWcState == 3) sdumpf("GAMELOG: wc24: suspended rc %d (previous %d)\r\n", (int)vgWcRc, (int)vgWcPrev);
+	else sdumpf("GAMELOG: wc24: not suspended (state %d rc %d)\r\n", (int)vgWcState, (int)vgWcRc);
+	vg_wc24_resume();
+	if (vgWcState == 3) sdumpf("GAMELOG: wc24: resumed rc %d\r\n", (int)vgWcResRc);
+	else if (vgWcState == 2) sdumpf("GAMELOG: wc24: left paused (it was paused before this run, previous %d)\r\n", (int)vgWcPrev);
+}
+#endif
