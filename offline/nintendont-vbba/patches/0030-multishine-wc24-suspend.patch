+#if VBBA_WC24
+/* HELPER THREAD (blocking: if the scheduler is mid-transfer the call returns when it has finished; only this thread waits, nobody serves EXI here). */
+static void vg_wc24_run(void)
+{
+	s32 rc;
+	if (kdFd < 0 || !vgWcOut) { vgWcRc = -1; vgWcState = -1; return; }
+	vgWcOut[0] = 0; sync_after_write(vgWcOut, 32);
+	rc = IOS_Ioctl(kdFd, 1, NULL, 0, vgWcOut, 32);
+	sync_before_read(vgWcOut, 32);
+	vgWcRc = rc; vgWcPrev = vgWcOut[0];
+	vgWcState = (rc < 0 || (s32)vgWcOut[0] < 0) ? -1 : 2;
+}
+#endif
