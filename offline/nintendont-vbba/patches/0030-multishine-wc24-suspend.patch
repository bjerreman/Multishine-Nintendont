+#define VBBA_WC24 1         /* (patch 0030, NIN_MS_WC24=1): pause WiiConnect24's scheduler (kd/request ioctl 1) once the address is up and resume it (ioctl 3) at shutdown; the design notes section 9; UNTESTED ON A CONSOLE */
