diff --git a/kernel/SDI.c b/kernel/SDI.c
index bf8a609..b546bcd 100644
--- a/kernel/SDI.c
+++ b/kernel/SDI.c
@@ -52,10 +52,11 @@ static u8 *rw_buffer;
  
 static char _sd0_fs[] = "/dev/sdio/slot0";
 
-vu32 vbbaSdOps;	/* Multishine: SD command counter, the vBBA releases its network start-up when the SD has been idle for a while */
+vu32 vbbaSdOps, vbbaSdBusy, vbbaSdLastEnd, vbbaSdMaxTicks;	/* Multishine: SD command counter, the vBBA releases its network start-up when the SD has been idle for a while */
 static s32 __sdio_sendcommand(u32 cmd,u32 cmd_type,u32 rsp_type,u32 arg,u32 blk_cnt,u32 blk_size,void *buffer,void *reply,u32 rlen)
 {
 	vbbaSdOps++;
+	vbbaSdBusy = (*(volatile u32 *)0x0d800010) | 1u;
 	struct _sdiomsg msg ALIGNED(32);
 	s32 ret;
 
@@ -85,6 +86,7 @@ static s32 __sdio_sendcommand(u32 cmd,u32 cmd_type,u32 rsp_type,u32 arg,u32 blk_
 	if(reply && !(rlen>16))
 		memcpy(reply,&msg.response,rlen);
 
+	{ u32 t = *(volatile u32 *)0x0d800010; if (t - vbbaSdBusy > vbbaSdMaxTicks) vbbaSdMaxTicks = t - vbbaSdBusy; vbbaSdLastEnd = t; vbbaSdBusy = 0; }
 	return ret;
 }
 
