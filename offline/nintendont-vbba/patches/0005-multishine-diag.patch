+void GCNCard_DiagState(u32 *o)      /* Multishine read-only view for the DIAG log lines */
+{
+	const GCNCard_ctx *c = &memCard[0];
+	o[0] = c->size; o[1] = (c->changed ? 1u : 0u) | (c->changed_system ? 2u : 0u); o[2] = c->BlockOff; o[3] = c->BlockOffLow; o[4] = c->BlockOffHigh; o[5] = c->CARDWriteCount;
+}
+
