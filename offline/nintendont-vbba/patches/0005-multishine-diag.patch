diff --git a/kernel/EXI.c b/kernel/EXI.c
index cf6aba0..952c911 100644
--- a/kernel/EXI.c
+++ b/kernel/EXI.c
@@ -692,10 +692,47 @@ u32 EXIDeviceSP1( u8 *Data, u32 Length, u32 Mode )
 	return 0;
 }
 
+
+/* ---- Multishine diagnostics: main-context only, RAM only (the log is written by the vBBA glue) ---- */
+struct exidiag { u32 tick, w0, w1; u8 dev; };
+static struct exidiag exiDiagRing[64];
+static u32 exiDiagHead;
+u32 exiDiagCmds, exiDiagLastTick, exiDiagBlocked, exiDiagSlowTicks, exiDiagSlowW0;
+static void EXIDiagRec( u32 command )
+{
+	u32 chn = (command >> 24) == 0x10 ? (command & 0xFF) : ((command >> 20) & 0xF);
+	struct exidiag *e = &exiDiagRing[exiDiagHead++ & 63];
+	e->tick = read32(HW_TIMER); e->w0 = command; e->w1 = read32(EXI_CMD_1);
+	e->dev = (command >> 24) == 0x10 ? (u8)((command >> 8) & 0xFF) : EXIDeviceSelect[chn & 3];
+	exiDiagCmds++; exiDiagLastTick = e->tick;
+}
+static void EXIDiagEnd( u32 command )
+{
+	u32 dt = read32(HW_TIMER) - exiDiagLastTick;
+	if (dt > 949000u && (command >> 24) != 0x10) { exiDiagSlowTicks = dt; exiDiagSlowW0 = command; }      /* a command that took more than 500 ms to serve (card commands wait on the SD) */
+}
+u32 EXIDiagCount( void ) { return exiDiagHead; }
+void EXIDiagEvent( u32 back, u32 now, char *out )
+{
+	struct exidiag *e = &exiDiagRing[(exiDiagHead - 1 - back) & 63];
+	_sprintf( out, "-%ums %02X/%08X/%08X d%u", (now - e->tick) / 1898u, e->w0 >> 24, e->w0, e->w1, e->dev );
+}
+void EXIDiagState( u32 *o )
+{
+	sync_before_read( (void*)EXI_INT, 0x20 );
+	o[0] = EXI_IRQ; o[1] = IRQ_Cause[0]; o[2] = IRQ_Cause[1]; o[3] = IRQ_Cause[2];
+	o[4] = IRQ_Timer ? (read32(HW_TIMER) - IRQ_Timer) / 1898u : 0;
+	o[5] = read32(EXI_INT); o[6] = exiDiagCmds; o[7] = exiDiagBlocked;
+	o[8] = (EXIDeviceSelect[0] << 16) | (EXIDeviceSelect[1] << 8) | EXIDeviceSelect[2];
+	o[9] = CurrentTiming;
+}
 void EXIUpdateRegistersNEW( void )
 {
 	if( EXI_IRQ == true ) //still working
+	{
+		exiDiagBlocked++;
 		return;
+	}
 
 	//u32 chn, dev, frq, ret, data, len, mode;
 	u32 chn, dev, ret, data, len, mode;
@@ -705,6 +742,7 @@ void EXIUpdateRegistersNEW( void )
 
 	if( command & 0xFF000000 )
 	{
+		EXIDiagRec( command );
 		switch( command >> 24 )
 		{
 			case 0x10:	// EXISelect
@@ -859,6 +897,7 @@ void EXIUpdateRegistersNEW( void )
 			{
 			} break;
 		}
+		EXIDiagEnd( command );
 	}
 }
 
