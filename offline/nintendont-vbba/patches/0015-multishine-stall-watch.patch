 {
 	static u32 logok;
-	dbgprintf("LOGOK %u errs %u open_err %u bytes %u\r\n", ++logok, dbgLogErrs, dbgLogOpenErr, dbgLogBytes);   /* a run that ends abruptly has its last LOGOK; a stale file has none */
+	dbgprintf("LOGOK %u errs %u open_err %u bytes %u\r\n", ++logok, dbgLogErrs, dbgLogOpenErr, dbgLogBytes);
+	dbgprintf("STALLMAX: longest %u ms at stage %u, now stage %u age %u ms, watchdog beats %u, entries %u\r\n", msCrumb.maxms, msCrumb.maxstage, msCrumb.stage, (u32)(read32(HW_TIMER) - msCrumb.t) / 1898u, msCrumb.wdbeat, msCrumb.n);   /* */   /* a run that ends abruptly has its last LOGOK; a stale file has none */
 	static u32 pt, pS[4][3], pB[4], pBl, pVi, pSf, pHook, pEv[VGR_N], pBbaD; static bool init;
 	u32 c, d, ms = pt ? (t - pt) / 1898u : 0, s3 = vg_dg_find_s3(), hook = 0, vi, sf, bba = 0, bbad, ev[VGR_N], evd;
 	sync_before_read((void *)VG_PM(0x804D7420u), 0x20);
@@ -1905,7 +1949,9 @@ void VBBAUpdate(void)
 		else if (ms >= (u32)VBBA_NET_CAP_S * 1000u) { vgNetReleased = true; dbgprintf("VBBA: net start released: cap reached at %u ms (SD ops %u)\r\n", ms, ops); }
 		else if (ms >= (u32)VBBA_NET_MIN_S * 1000u && (u32)(ms - last_chg) >= (u32)VBBA_NET_IDLE_S * 1000u) { vgNetReleased = true; dbgprintf("VBBA: net start released: SD idle for %u s at %u ms (SD ops %u)\r\n", (u32)VBBA_NET_IDLE_S, ms, ops); }
 	}
+	MS_ST(MSS_VREOPEN);
 	vg_reopen();                                        /* missing handles / ncd: blocking opens belong here, not on the fast thread */
+	MS_ST(MSS_VBBA);
 #if VBBA_LIVE_LOG
 	vg_drain();                                         /* start-up trace lines, printed here (main thread) */
 #endif
@@ -1915,6 +1961,7 @@ void VBBAUpdate(void)
 	/* b17b: the timeline lines every VBBA_TL_PERIOD_S seconds, so they reach /ndebug.log even when the shutdown block never comes.
 	   One line per main-loop pass (each dbgprintf is one SD write + sync), never while a disc read may be in FatFs (DI_IRQ, the
 	   same rule as GCNCard_Save; FatFs is not reentrant) or during a card-save hold.  The main-loop gap counter skips our own writes. */
+	MS_ST(MSS_VTL);
 	if (!vgTlInit) { vgTlInit = true; vgTlTick = now; }
 	{ u32 d = (u32)(now - vgTlTick) / 1898u; vgTlTick += d * 1898u; vgTlMs += d; }     /* whole ms (HW_TIMER 1.898 MHz) */
 	if (vgTlK >= VG_TL_LINES && vgTlMs >= vgTlNext) { vgTlK = 0; vgNetLn = 0; vgTlNext = vgTlMs + VBBA_TL_PERIOD_MS; vgTlAt = vgTlMs / 1000u; }
diff --git a/kernel/vbba_stall.h b/kernel/vbba_stall.h
new file mode 100644
index 0000000..9052fa2
--- /dev/null
+++ b/kernel/vbba_stall.h
@@ -0,0 +1,40 @@
+/* stall breadcrumbs.  The main loop and dbgprintf note the stage they are in (a number and the HW_TIMER at entry); a watchdog
+   thread (vbba_glue.c) reads them every 200 ms, drives the slot LED (slow blink healthy, fast blink main loop stalled outside FatFs,
+   solid on stalled inside FatFs/SD, frozen LED = the whole ARM side stopped) and keeps the longest stall per stage for the 10 s line. */
+#ifndef VBBA_STALL_H
+#define VBBA_STALL_H
+#ifndef MS_STALL_HOST
+#include "global.h"
+#endif
+#define MSS_TOP 1
+#define MSS_DI 2          /* FatFs: ISO read (DiscCheckAsync / DIInterrupt) */
+#define MSS_SAVE 3        /* FatFs: GCNCard_Save */
+#define MSS_USB 4
+#define MSS_WAIT 5        /* the main loop's udelay */
+#define MSS_VBBA 6        /* VBBAUpdate, first part */
+#define MSS_VREOPEN 7     /* vg_reopen: blocking IOS opens */
+#define MSS_VTL 8         /* timeline lines (dbgprintf) */
+#define MSS_EXI 9
+#define MSS_PADS 10       /* GCAM / BT / HID / SI */
+#define MSS_SOCK 11
+#define MSS_MISC 12       /* Stream, OSReport, card change check */
+#define MSS_RESET 13
+#define MSS_LOG_OPEN 20   /* FatFs */
+#define MSS_LOG_WRITE 21  /* FatFs */
+#define MSS_LOG_SYNC 22   /* FatFs */
+#define MSS_IS_FAT(s) ((s) == MSS_DI || (s) == MSS_SAVE || ((s) >= MSS_LOG_OPEN && (s) <= MSS_LOG_SYNC))
+struct ms_crumb {
+	volatile u32 stage, t, n;       /* current stage, HW_TIMER at its entry, entries counted */
+	volatile u32 wd;                /* 1 while the watchdog thread is inside its own dbgprintf (the crumbs are then left alone) */
+	volatile u32 maxms, maxstage;   /* longest stall seen by the watchdog, and where */
+	volatile u32 wdbeat;            /* watchdog loop counter (200 ms each) */
+	volatile u32 curms, curstage;   /* the stall in progress (0 = none) */
+};
+extern struct ms_crumb msCrumb;
+/* the watchdog's decision (pure, host tested in tests/stall_watch_test.c): 0 = moving, 1 = stuck 3 s or more outside FatFs, 2 = stuck 3 s or more inside FatFs */
+#define MSS_STALL_MS 3000u
+static inline u32 ms_stall_mode(u32 age_ms, u32 stage) { return age_ms < MSS_STALL_MS ? 0u : (MSS_IS_FAT(stage) ? 2u : 1u); }
+/* a STALL line is due at the first check of a stall and then every 5 s, at most 12 lines (logged = the age at the previous line, 0 = none yet) */
+static inline u32 ms_stall_log_due(u32 mode, u32 age_ms, u32 logged) { return mode == 1u && (!logged || age_ms >= logged + 5000u) && logged < 60000u; }
+#define MS_ST(s) do { if (!msCrumb.wd) { msCrumb.stage = (s); msCrumb.t = read32(HW_TIMER); msCrumb.n++; } } while (0)
+#endif
