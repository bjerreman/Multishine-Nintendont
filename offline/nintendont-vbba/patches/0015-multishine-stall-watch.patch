+/* the stall watchdog.  Its own IOS thread (it does not depend on the main loop): every 200 ms it looks at the main loop's breadcrumb (MS_ST in main.c and
+   dbgprintf).  Slot LED: slow blink = the main loop keeps moving; fast blink (5 Hz) = stuck 3 s or more outside FatFs (a STALL line goes to /ndebug.log, at most
+   one per 5 s, never while a disc read is running); solid on = stuck inside FatFs / on the SD card (no log line is possible then; the next 10 s line after it frees
+   up reports the longest stall); the LED frozen = the ARM side as a whole stopped. */
+static u32 *vgWdStack; static u32 vgWdThread;
+static u32 VBBAWdThread(void *arg)
+{
+	u32 lastn = 0, lastchg = read32(HW_TIMER), logged = 0, led = 0, beat = 0, shortSleeps = 0;
+	(void)arg;
+	while (1) {
+		u32 t0 = read32(HW_TIMER), now, n, st, age, mode;
+		udelay(200000);
+		now = read32(HW_TIMER); n = msCrumb.n; st = msCrumb.stage; beat++;
+		if ((u32)(now - t0) < 38000u) {                      /* udelay returned early (no queue or timer): do not spin above the main loop */
+			if (++shortSleeps >= 8u) { shortSleeps = 0; thread_set_priority(vgWdThread, 0x40); }
+		} else shortSleeps = 0;
+		msCrumb.wdbeat = beat;
+		if (n != lastn) { lastn = n; lastchg = now; logged = 0; }
+		age = (u32)(now - lastchg) / 1898u;
+		if (age >= 3000u) {
+			mode = ms_stall_mode(age, st);
+			msCrumb.curms = age; msCrumb.curstage = st;
+			if (age > msCrumb.maxms) { msCrumb.maxms = age; msCrumb.maxstage = st; }
+			if (!DI_IRQ && ms_stall_log_due(mode, age, logged)) {
+				logged = age;
+				msCrumb.wd = 1;
+				dbgprintf("STALL: main loop stuck %u ms at stage %u (entries %u, vBBA main_beat %u, sd ops %u, hold %u, started %u)\r\n", age, st, n, vst ? vst->main_beat : 0u, vbbaSdOps, (u32)vgHold, (u32)vgStarted);
+				msCrumb.wd = 0;
+			}
+		} else { mode = 0; if (msCrumb.curms) { msCrumb.curms = 0; } }
+		if (mode == 2u) set32(HW_GPIO_OUT, GPIO_SLOT_LED);
+		else if (mode == 1u || (beat & 1u) == 0) { led ^= 1u; if (led) set32(HW_GPIO_OUT, GPIO_SLOT_LED); else clear32(HW_GPIO_OUT, GPIO_SLOT_LED); }
+	}
+	return 0;
+}
