 #if VBBA_SYNCTX
 	vgTxThread = thread_create(VBBASendThread, NULL, vgTxStack + 0x400 / sizeof(u32), 0x400 / sizeof(u32), 0x78, 1);
 	thread_continue(vgTxThread);
@@ -1767,7 +1810,8 @@ extern u32 dbgLogErrs, dbgLogBytes, dbgLogOpenErr;   /* kernel/vsprintf.c */
