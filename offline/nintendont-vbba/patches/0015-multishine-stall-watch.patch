 	vgNetStack = (u32 *)heap_alloc_aligned(vgHeap, VBBA_NET_STACK, 32);
+	vgWdStack = (u32 *)heap_alloc_aligned(vgHeap, 0x1000, 32);   /* */
 #if VBBA_SYNCTX
