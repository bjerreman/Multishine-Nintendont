 /* ---- EXI hooks (called by EXIUpdateRegistersNEW from the vBBA thread) ---- */
+/* (diagnostic only): what the guest's driver writes to the adapter that looks like a (re)start, seen at the EXI hooks.  The fast thread only stores raw ticks into a small ring
+   (no log call from the thread); the main thread prints them (vg_reg_drain) and totals them in the 10 s line.  Register port write = 4-byte immediate 'C0 AA AA xx', the data follows
+   as the next immediate or DMA of the same select; command port write = immediate 'cmd data'.  Events: NCRA (reg 0x00) RESET bit or RX-enable (SR) bit changes, NWAYC (0x30) and
+   SIACTRL2 (0x60) writes (link re-init), IMR (0x08) changes, command port 0x44 (device id), 0x45 (acstart), 0x49 (challenge response) = the authentication handshake starting over. */
+enum { VGR_NCRA_RST_ON = 0, VGR_NCRA_RST_OFF, VGR_SR_ON, VGR_SR_OFF, VGR_NWAYC, VGR_SIACTRL2, VGR_IMR, VGR_DEVID, VGR_ACSTART, VGR_RESPONSE, VGR_N };
+static const char *const vgRegName[VGR_N] = { "NCRA RESET set", "NCRA RESET cleared", "NCRA SR (rx enable) set", "NCRA SR (rx enable) cleared", "NWAYC written (link re-init)", "SIACTRL2 written", "IMR changed", "cmd 0x44 device id (handshake start)", "cmd 0x45 acstart", "cmd 0x49 challenge response" };
+struct vg_regev { u32 tick; u16 kind, val; };
+static struct vg_regev vgRegRing[32];
+static volatile u32 vgRegHead, vgRegTail, vgRegLost;
+static u32 vgRegCnt[VGR_N], vgRegAddr = 0xFFFFFFFFu, vgRegPrevNcra, vgRegPrevImr = 0x100u;
+static void vg_reg_ev(u32 kind, u32 val)
+{
+	vgRegCnt[kind]++;
+	if (vgRegHead - vgRegTail >= 32u) { vgRegLost++; return; }
+	vgRegRing[vgRegHead & 31u].tick = read32(HW_TIMER); vgRegRing[vgRegHead & 31u].kind = (u16)kind; vgRegRing[vgRegHead & 31u].val = (u16)val;
+	vgRegHead++;
+}
+static void vg_reg_wr(u32 a, u32 v)
+{
+	v &= 0xFFu;
+	if (a == 0x00u) {
+		if ((v & 1u) && !(vgRegPrevNcra & 1u)) vg_reg_ev(VGR_NCRA_RST_ON, v);
+		if (!(v & 1u) && (vgRegPrevNcra & 1u)) vg_reg_ev(VGR_NCRA_RST_OFF, v);
+		if ((v & 8u) && !(vgRegPrevNcra & 8u)) vg_reg_ev(VGR_SR_ON, v);
+		if (!(v & 8u) && (vgRegPrevNcra & 8u)) vg_reg_ev(VGR_SR_OFF, v);
+		vgRegPrevNcra = v;
+	} else if (a == 0x30u) vg_reg_ev(VGR_NWAYC, v);
+	else if (a == 0x60u) vg_reg_ev(VGR_SIACTRL2, v);
+	else if (a == 0x08u) { if (v != vgRegPrevImr) vg_reg_ev(VGR_IMR, v); vgRegPrevImr = v; }
+}
+static void vg_reg_bytes(const u8 *b, u32 len)       /* the data bytes of a register-port write that follows its header */
+{
+	u32 i;
+	if (vgRegAddr == 0xFFFFFFFFu) return;
+	if (vgRegAddr == 0x48u) return;                  /* transmit FIFO port: frame bytes, no auto-increment */
+	for (i = 0; i < len && i < 8u; i++) vg_reg_wr(vgRegAddr + i, b[i]);
+	vgRegAddr += len;
+}
+static void vg_reg_imm(u32 data, u32 len)            /* immediate WRITE of 1..4 bytes, data left-aligned */
+{
+	u8 b[4]; u32 i;
+	for (i = 0; i < len && i < 4u; i++) b[i] = (u8)(data >> (24 - 8 * i));
+	if (vgRegAddr != 0xFFFFFFFFu) { vg_reg_bytes(b, len); return; }
+	if (len == 4u && (b[0] & 0xC0u) == 0xC0u) { vgRegAddr = ((u32)b[1] << 8) | b[2]; return; }   /* header of a register-port write */
+	if (len >= 2u) {
+		if (b[0] == 0x44u) vg_reg_ev(VGR_DEVID, b[1]);
+		else if (b[0] == 0x45u) vg_reg_ev(VGR_ACSTART, b[1]);
+		else if (b[0] == 0x49u) vg_reg_ev(VGR_RESPONSE, b[1]);
+	}
+}
+static void vg_reg_drain(void)                       /* main thread */
+{
+	while (vgRegTail != vgRegHead) {
+		struct vg_regev e = vgRegRing[vgRegTail & 31u];
+		vgRegTail++;
+		dbgprintf("DIAG: bba reg event %s (value %02X) %u ms ago, at %u ms\r\n", vgRegName[e.kind < VGR_N ? e.kind : 0], e.val, (read32(HW_TIMER) - e.tick) / 1898u, vg_now_ms(NULL));   /* longest name 36 characters */
+		dbgprintf("DIAG: bba reg totals rst %u sr-on %u nway %u siactrl2 %u handshake %u/%u/%u\r\n",
+			vgRegCnt[VGR_NCRA_RST_ON], vgRegCnt[VGR_SR_ON], vgRegCnt[VGR_NWAYC], vgRegCnt[VGR_SIACTRL2], vgRegCnt[VGR_DEVID], vgRegCnt[VGR_ACSTART], vgRegCnt[VGR_RESPONSE]);
+	}
+	if (vgRegLost) { dbgprintf("DIAG: bba reg events lost (ring full): %u\r\n", vgRegLost); vgRegLost = 0; }
+}
+
