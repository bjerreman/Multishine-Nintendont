+	vgRegAddr = 0xFFFFFFFFu;
 	if (V) (void)vbba_ndexi_select(&V->chip, &V->nx, chn, dev);
 }
 
 u32 VBBAExiImm(u32 data, u32 len, u32 mode)
 {
 	if (!V) return 0;
+	if (mode == 1) vg_reg_imm(data, len);
 	return vbba_ndexi_imm(&V->chip, &V->nx, data, len, mode);
 }
 
@@ -911,6 +977,7 @@
 	u32 a = (u32)ptr & ~31u, n = round32(((u32)ptr & 31u) + len);
 	if (!V) return;
 	if (mode == 1) sync_before_read((void *)a, n);          /* guest -> chip: see the PowerPC's data */
+	if (mode == 1) vg_reg_bytes((const u8 *)ptr, len);
 	vbba_ndexi_dma(&V->chip, &V->nx, ptr, len, mode);
 	if (mode != 1) sync_after_write((void *)a, n);          /* chip -> guest: publish ours */
 }
@@ -1546,6 +1613,113 @@
    L2 card: size, chg (1 = data changed, 2 = system area changed), current/low/high modified offsets, write count; sd = commands, longest ms, ms since the last one ended; hold = card save in progress.
    L3-6 ev: the last 16 EXI commands newest last: '-ms ago kind/command word/data word dDevice' (kind 10 select, 11 immediate, 12 DMA).  L7: words of the game (scene state) that move while it runs. */
 #define VG_DG(a) (*(const volatile u32 *)((a) & 0x01FFFFFFu))
+/* ---- (diagnostic only, reads only): is the PowerPC alive, and where did it stop?  Called at the end of vg_diag_dump (so only while the guest is silent for 5 s or an SD command hangs).
+   L8  s3:  the engine's own status block, found by its 'S3ST' magic (the card-route image base is not the lab/online one): state, hook calls and B0 calls (+ change since the previous DIAG set),
+            spin = the S20 breadcrumb BC(x) the PowerPC flushes with dcbst (0x01..0x06 hook, 0x1x EXI op started, 0x2xx issued and waiting in EXISync, 0x1xx finished), ip = the address the guest holds.
+   L9  ppc: VI retrace counter 0x804D7420 and scene_frames 0x80479D58 (+ change): both moving = the game runs (and the hook is not reached), retrace moving + scene frames still = the game thread is blocked,
+            both still = the PowerPC is stopped or has interrupts off.  CAVEAT: plain PowerPC stores can sit in its data cache: a still counter is strong evidence only together with the breadcrumb.
+   L10 irq: what the ARM has raised towards the PowerPC (PPCIRQFLAG/MASK, the four interrupt words, SI_IRQ, DI_IRQ): a bit raised and never taken = interrupts off on the PowerPC.
+   L11 time: first guest select of the BBA relative to the link-up signal (negative = the guest looked before the link was up). */
+#define VG_PM(a) ((const volatile u32 *)((a) & 0x01FFFFFFu))
+#define VG_S3_MAGIC 0x53335354u
+static u32 vgDgS3, vgDgScans, vgDgPrev[4], vgDgPrevT;
+static u32 vg_dg_find_s3(void)
+{
+	u32 a, i;
+	if (vgDgS3 || vgDgScans >= 3u) return vgDgS3;
+	vgDgScans++;
+	for (a = 0x80400000u; a < 0x80600000u; a += 0x20u) {         /* 2 MiB, 64 K cache-line invalidates, once per DIAG set until found (the guest is silent or the SD is stuck anyway) */
+		const volatile u32 *p = VG_PM(a);
+		sync_before_read((void *)p, 0x20);
+		for (i = 0; i < 8u; i++) {
+			if (p[i] == VG_S3_MAGIC) {
+				u32 c = a + 4u * i;
+				const volatile u32 *s = VG_PM(c);
+				sync_before_read((void *)((u32)s & ~31u), 0x120);
+				if (s[1] < 0x100u && s[39] < 0x1000u && s[3] != 0xFFFFFFFFu) { vgDgS3 = c; return c; }
+			}
+		}
+	}
+	return 0;
+}
+static void vg_diag_ppc(void)
+{
+	extern u32 SI_IRQ;
+	u32 t = read32(HW_TIMER), dt = vgDgPrevT ? (t - vgDgPrevT) / 1898u : 0, s3 = vg_dg_find_s3(), calls = 0, b0 = 0, vi, sf;
+	sync_before_read((void *)VG_PM(0x804D7420u), 0x20);
+	sync_before_read((void *)VG_PM(0x80479D40u), 0x20);
+	vi = VG_PM(0x804D7420u)[0]; sf = VG_PM(0x80479D58u)[0];
+	if (s3) {
+		const volatile u32 *s = VG_PM(s3);
+		sync_before_read((void *)((u32)s & ~31u), 0x120);
+		calls = s[3]; b0 = s[5];
+		dbgprintf("DIAG: s3 @%08X state %X calls %u (+%u) b0 %u (+%u) spin %X ip %08X in %u ms\r\n", s3, s[1], calls, calls - vgDgPrev[0], b0, b0 - vgDgPrev[1], s[39], s[4], dt);
+	} else dbgprintf("DIAG: s3 not found in 80400000..80600000 (scan %u)\r\n", vgDgScans);
+	dbgprintf("DIAG: ppc vi %u (+%u) scene_frames %u (+%u) in %u ms | guest %s\r\n", vi, vi - vgDgPrev[2], sf, sf - vgDgPrev[3], dt,
+		!vgDgPrevT ? "first sample" : (vi != vgDgPrev[2] || sf != vgDgPrev[3] || (s3 && calls != vgDgPrev[0])) ? "ALIVE (a retrace, scene frame or hook counter moved)" : "NO COUNTER MOVED (stopped, or its stores sit in the data cache)");
+	sync_before_read((void *)INT_BASE, 0x80);
+	dbgprintf("DIAG: irq ppcflag %08X mask %08X | RSW %08X DI %08X SI %08X EXI %08X | si_irq %02X di_irq %u\r\n", read32(HW_PPCIRQFLAG), read32(HW_PPCIRQMASK), read32(RSW_INT), read32(DI_INT), read32(SI_INT), read32(EXI_INT), SI_IRQ & 0xFFu, (u32)DI_IRQ);
+	{   /* L12 exi: a command the PowerPC has posted and the kernel has not taken (cmd0 != 0) with the EXI lock free = nothing is serving it; lock HELD with the main loop between passes = a leaked lock */
+		u32 c0, c1, got;
+		sync_before_read((void *)EXI_BASE, 0x20);
+		c0 = read32(EXI_CMD_0); c1 = read32(EXI_CMD_1);
+		got = (u32)EXILockTry(); if (got) EXIUnlock();
+		dbgprintf("DIAG: exi posted cmd0 %08X cmd1 %08X lock %s | card-save holds %u, last began %u ms ago\r\n", c0, c1, got ? "free" : "HELD", vst->holds, vgHoldTicks ? (t - vgHoldTicks) / 1898u : 0u);
+	}
+	if (vgFirstSelTick && vgLinkTick) dbgprintf("DIAG: time first BBA select %d ms after link-up (%u ms ago)\r\n", (int)((s32)(vgFirstSelTick - vgLinkTick) / 1898), (t - vgFirstSelTick) / 1898u);
+	else dbgprintf("DIAG: time first BBA select %s, link-up %s\r\n", vgFirstSelTick ? "seen" : "never", vgLinkTick ? "seen" : "never");
+	vgDgPrev[0] = calls; vgDgPrev[1] = b0; vgDgPrev[2] = vi; vgDgPrev[3] = sf; vgDgPrevT = t;
+}
+/* every 10 s, stall or not (so a stop is visible as a line whose '+' deltas go to 0):
+   10s a: commands taken for service per channel and device class (card / BBA / other), BBA commands by kind (select, immediate, DMA), 'blocked' passes, all as total and delta.
+   10s b: proof of life of the PowerPC: VI retrace counter, scene_frames, the engine's hook-call counter (S3 block), each as value and delta; plus the BBA register events of section vg_reg_*.
+   The overlay's own frame counter has no fixed address that is known here; hook calls are the engine's per-frame counter and stand in for it. */
+static void vg_diag_10s(u32 t)
+{
+	static u32 pt, pS[4][3], pB[4], pBl, pVi, pSf, pHook, pEv[VGR_N], pBbaD; static bool init;
+	u32 c, d, ms = pt ? (t - pt) / 1898u : 0, s3 = vg_dg_find_s3(), hook = 0, vi, sf, bba = 0, bbad, ev[VGR_N], evd;
+	sync_before_read((void *)VG_PM(0x804D7420u), 0x20);
+	sync_before_read((void *)VG_PM(0x80479D40u), 0x20);
+	vi = VG_PM(0x804D7420u)[0]; sf = VG_PM(0x80479D58u)[0];
+	if (s3) { const volatile u32 *s = VG_PM(s3); sync_before_read((void *)((u32)s & ~31u), 0x120); hook = s[3]; }
+	for (c = 0; c < 4u; c++) bba += exiServed[c][1];
+	bbad = bba - pBbaD;
+	dbgprintf("DIAG: 10s %u ms | served card ch0 +%u (%u) ch1 +%u ch2 +%u\r\n", ms, exiServed[0][0] - pS[0][0], exiServed[0][0], exiServed[1][0] - pS[1][0], exiServed[2][0] - pS[2][0]);
+	dbgprintf("DIAG: 10s served bba ch0 +%u (%u) ch1 +%u ch2 +%u | other ch0 +%u ch1 +%u ch2 +%u\r\n", exiServed[0][1] - pS[0][1], exiServed[0][1], exiServed[1][1] - pS[1][1], exiServed[2][1] - pS[2][1],
+		exiServed[0][2] - pS[0][2], exiServed[1][2] - pS[1][2], exiServed[2][2] - pS[2][2]);
+	dbgprintf("DIAG: 10s bba cmds sel +%u (%u) imm +%u (%u) dma +%u (%u) | blocked +%u (%u)\r\n",
+		exiServedBba[0] - pB[0], exiServedBba[0], exiServedBba[1] - pB[1], exiServedBba[1], exiServedBba[2] - pB[2], exiServedBba[2], exiDiagBlocked - pBl, exiDiagBlocked);
+	ev[0] = vgRegCnt[VGR_NCRA_RST_ON]; ev[1] = vgRegCnt[VGR_SR_ON]; ev[2] = vgRegCnt[VGR_NWAYC] + vgRegCnt[VGR_SIACTRL2]; ev[3] = vgRegCnt[VGR_DEVID] + vgRegCnt[VGR_ACSTART] + vgRegCnt[VGR_RESPONSE]; ev[4] = vgRegCnt[VGR_IMR];
+	evd = 0; for (d = 0; d < 5u; d++) evd += ev[d] - pEv[d];
+	dbgprintf("DIAG: 10s guest %s | vi %u (+%u) scene_frames %u (+%u) hook_calls %u (+%u)\r\n",
+		(!init) ? "first sample" : (vi != pVi || sf != pSf || hook != pHook) ? "ALIVE" : "NO COUNTER MOVED", vi, vi - pVi, sf, sf - pSf, hook, hook - pHook);
+	dbgprintf("DIAG: 10s bba reg events +%u: rst %u sr-on %u nway/siactrl2 %u handshake %u imr %u\r\n", evd, ev[0], ev[1], ev[2], ev[3], ev[4]);
+	if (init && bbad == 0) {
+		if (vi != pVi || sf != pSf || hook != pHook) dbgprintf("DIAG: 10s <== guest ALIVE but no BBA command served in this interval\r\n");
+		else dbgprintf("DIAG: 10s <== no BBA command served and no guest counter moved\r\n");
+	}
+	for (c = 0; c < 4u; c++) for (d = 0; d < 3u; d++) pS[c][d] = exiServed[c][d];
+	for (c = 0; c < 4u; c++) pB[c] = exiServedBba[c];
+	for (d = 0; d < 5u; d++) pEv[d] = ev[d];
+	pBl = exiDiagBlocked; pVi = vi; pSf = sf; pHook = hook; pBbaD = bba; pt = t; init = true;
+}
+/* a command is posted in EXI_CMD_0 (the guest asked for a select or transfer) and nothing takes it for more than 250 ms: one line every 3 s while that lasts */
+static void vg_diag_posted(u32 t)
+{
+	static u32 val, since, cmds, lastpr;
+	u32 c0, c1, chn, dev, st[10];
+	sync_before_read((void *)EXI_BASE, 0x20);
+	c0 = read32(EXI_CMD_0);
+	if (!(c0 & 0xFF000000u) || c0 != val || exiDiagCmds != cmds) { val = c0; cmds = exiDiagCmds; since = (c0 & 0xFF000000u) ? t : 0; return; }
+	if (!since || (u32)(t - since) <= 474500u || (lastpr && (u32)(t - lastpr) <= 5694000u)) return;
+	lastpr = t; c1 = read32(EXI_CMD_1); EXIDiagState(st);
+	if ((c0 >> 24) == 0x10u) { chn = c0 & 0xFFu; dev = (c0 >> 8) & 0xFFu; } else { chn = (c0 >> 20) & 0xFu; dev = chn < 3u ? (st[8] >> (16 - 8 * chn)) & 0xFFu : 0xFFu; }
+	{
+		u32 got = (u32)EXILockTry(); if (got) EXIUnlock();
+		dbgprintf("DIAG: exi cmd %08X/%08X posted %u ms ago and NOT served | target ch%u dev%u%s\r\n", c0, c1, (t - since) / 1898u, chn, dev, dev == 2 ? " (BBA)" : dev == 0 ? " (card)" : "");
+		dbgprintf("DIAG: exi not served: lock %s, fake irq pending %u, served %u, last served %u ms ago, blocked %u\r\n", got ? "free" : "HELD", st[0], exiDiagCmds, (t - exiDiagLastTick) / 1898u, exiDiagBlocked);
+	}
+}
