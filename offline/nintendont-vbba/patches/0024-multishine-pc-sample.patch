diff --git a/kernel/asm/FakeInterrupt.S b/kernel/asm/FakeInterrupt.S
index eb63bf7..de43044 100644
--- a/kernel/asm/FakeInterrupt.S
+++ b/kernel/asm/FakeInterrupt.S
@@ -3,6 +3,37 @@
 
 FakeInterrupt:
 	lwz		r31,	0x3000(r3)
+	# (NIN_MS_PCSAMPLE): every pass through the OS interrupt dispatcher stores where it interrupted the guest (the saved context passed
+	# as the 2nd argument, r30 here) plus the real PI INTSR / INTMR and the OS mask word into a ring of 4 x 32 bytes in uncached shared memory
+	# (0xD3026700: counter, then entries at +0x20 + 0x20 * (counter & 3)) that the ARM reads without any cache problem.
+	lis		r5,	0x8000
+	cmplw		r30,	r5
+	blt		SampleDone
+	lis		r5,	0x8180
+	cmplw		r30,	r5
+	bge		SampleDone
+	lis		r6,	0xD302
+	lwz		r7,	0x6700(r6)
+	addi		r7,	r7,	1
+	stw		r7,	0x6700(r6)
+	andi.		r7,	r7,	3
+	slwi		r7,	r7,	5
+	add		r6,	r6,	r7
+	lwz		r5,	0x198(r30)		#srr0
+	stw		r5,	0x6720(r6)
+	lwz		r5,	0x19C(r30)		#srr1
+	stw		r5,	0x6724(r6)
+	lwz		r5,	0x84(r30)		#lr
+	stw		r5,	0x6728(r6)
+	lwz		r5,	4(r30)			#r1
+	stw		r5,	0x672C(r6)
+	stw		r31,	0x6730(r6)		#PI INTSR (real)
+	lwz		r5,	0x3004(r3)		#PI INTMR (real)
+	stw		r5,	0x6734(r6)
+	lis		r5,	0x8000
+	lwz		r5,	0xC4(r5)		#OS masked-interrupts word
+	stw		r5,	0x6738(r6)
+SampleDone:
 	andi.	r0,	r31,	0x4000	#check if IPC IRQ
 	rlwinm	r31,	r31,	0, 18, 31 #relevant irqs
 	beq		end		#if bit 14=0 then no need to check
diff --git a/kernel/main.c b/kernel/main.c
index e436ff1..a92ab66 100644
--- a/kernel/main.c
+++ b/kernel/main.c
@@ -240,6 +240,8 @@ int _main( int argc, char *argv[] )
 
 	memset32((void*)0x13026500, 0, 0x100);
 	sync_after_write((void*)0x13026500, 0x100);
+	memset32((void*)0x13026700, 0, 0xA0);   /* the PowerPC interrupt-sample ring (FakeInterrupt.S) */
+	sync_after_write((void*)0x13026700, 0xA0);
 
 	BootStatus(9, s_size, s_cnt);
 
diff --git a/kernel/vbba_glue.c b/kernel/vbba_glue.c
index 99e82d6..7d84633 100644
--- a/kernel/vbba_glue.c
+++ b/kernel/vbba_glue.c
@@ -338,6 +338,7 @@ static volatile u32 vgNoStart = (VBBA_OFF) & 64;
 static u32 vgAutoWrite, vgCfgState, vgCfgDuty, vgAutoInfo, vgBaked = 0xFFFFFFFFu;                /* what VBBAConfigLoad found (copied into the status block when the vBBA starts) */
 static u32 vgSpinTicks = VBBA_SPIN_TICKS, vgIdleUs = VBBA_IDLE_US, vgPrio = VBBA_THREAD_PRIO, vgAdaptive = 0, vgMainUs = VBBA_MAIN_US;
 static u32 vgCfgAuto = 0u, vgApAt, vgApRun, vgApTotal;   /* /vbba.cfg autopoke=SECONDS (default 4, 0 = off): the guest has been silent that long and its newest EXI command was a channel 0 DMA: its transfer-complete interrupt may have been lost; throw it again (at most 8 per silence, one per period) */
+static u32 vgCfgGate = 1u, vgRegLastTick;   /* /vbba.cfg gate=0|1 (default 1): the default-timing net start (SD idle for 3 s) also waits until the guest has finished its BBA init handshake (challenge response and rx enable seen) and that was 3 s ago; the cap still applies */
 static u32 vgCfgPoke, vgPokeAt, vgPokes;      /* experiment switch /vbba.cfg irqpoke=SECONDS (0 = off, default): when the guest has posted no EXI command for N s, throw one spurious EXI transfer-complete interrupt (every 5 s at most): tests the lost-interrupt theory */
 static u32 vgCfgNetDelayS, vgCfgNoBba, vgCfgNetEarly;   /* netearly=SECONDS (1..30) is netdelay with another log text: the net start is released N s after the vBBA started whatever the SD is doing (no SD-idle wait) */
 /* test switches from /vbba.cfg: netdelay=SECONDS (net start not before N s after the vBBA started), nobba=1 (the vBBA is never started); both 0 = the behaviour */
@@ -989,6 +990,7 @@ static u32 vgRegCnt[VGR_N], vgRegAddr = 0xFFFFFFFFu, vgRegPrevNcra, vgRegPrevImr
 static void vg_reg_ev(u32 kind, u32 val)
 {
 	vgRegCnt[kind]++;
+	vgRegLastTick = read32(HW_TIMER) | 1u;
 	if (vgRegHead - vgRegTail >= 32u) { vgRegLost++; return; }
 	vgRegRing[vgRegHead & 31u].tick = read32(HW_TIMER); vgRegRing[vgRegHead & 31u].kind = (u16)kind; vgRegRing[vgRegHead & 31u].val = (u16)val;
 	vgRegHead++;
@@ -1374,6 +1376,7 @@ void VBBAConfigLoad(void)
 		else if (!strncmp(tok, "nosave=", 7)) { u32 v = vg_num(tok + 7, 10, &ok); if (ok) vbbaCfgNoSave = v ? 1u : 0u; }
 		else if (!strncmp(tok, "sdprobe=", 8)) { u32 v = vg_num(tok + 8, 10, &ok); if (ok) vbbaCfgSdProbe = v ? 1u : 0u; }
 		else if (!strncmp(tok, "irqpoke=", 8)) { u32 v = vg_num(tok + 8, 10, &ok); if (ok && v >= 3u && v <= 600u) vgCfgPoke = v; else if (ok && v == 0u) vgCfgPoke = 0; else ok = false; }
+		else if (!strncmp(tok, "gate=", 5)) { u32 v = vg_num(tok + 5, 10, &ok); if (ok && v <= 1u) vgCfgGate = v; else ok = false; }
 		else if (!strncmp(tok, "autopoke=", 9)) { u32 v = vg_num(tok + 9, 10, &ok); if (ok && (v == 0u || (v >= 1u && v <= 60u))) vgCfgAuto = v; else ok = false; }
 		else ok = false;
 		if (!ok) state |= 2;
@@ -1409,6 +1412,7 @@ void VBBAConfigLog(void)
 	dbgprintf("VBBA: cfg: %s %u s, nobba %u (0 = off, the behaviour)\r\n", vgCfgNetEarly ? "netearly" : "netdelay", vgCfgNetDelayS, vgCfgNoBba);
 	if (vbbaCfgNoSave || vbbaCfgSdProbe) dbgprintf("VBBA: cfg: nosave %u (the memory card is never written to the SD), sdprobe %u (SD sector 0 read once a second, slot LED)\r\n", vbbaCfgNoSave, vbbaCfgSdProbe);
 	dbgprintf("VBBA: cfg: autopoke %u s (0 = off), EXI channel table at %08X\r\n", vgCfgAuto, ExiChanTabAddr);
+	dbgprintf("VBBA: cfg: gate %u (1 = the default-timing net start waits for the guest's BBA init, 0 = timing)\r\n", vgCfgGate);
 	if (vgCfgPoke) dbgprintf("VBBA: cfg: irqpoke %u s (experiment: a spurious EXI TC interrupt after that long a guest silence)\r\n", vgCfgPoke);
 	if (VBBA_STEP < 2) return;
 	dbgprintf("VBBA: duty %u (baked %d%s, /vbba.cfg %s), spin %u ticks, idle %u us%s, priority %02X, main-loop sleep %u us\r\n", vgCfgDuty, vgBaked <= 5u ? (int)vgBaked : -1,
@@ -1821,6 +1825,7 @@ static u32 vg_dg_find_s3(void)
    (a running thread's context is only written at a switch) and PowerPC stores can sit in its data cache, so the same line twice in a row is the useful signal. */
 static u32 vg_pm_ok(u32 a) { return a >= 0x80000000u && a < 0x81800000u && !(a & 3u); }
 static u32 vg_pm_rd(u32 a) { if (!vg_pm_ok(a)) return 0; sync_before_read((void *)((u32)VG_PM(a) & ~31u), 0x20); return *VG_PM(a); }
+static void vg_diag_pc(void);   /* */
 static void vg_diag_os(void)
 {
 	u32 cur_ctx, head, curthr, t, n;
@@ -1836,6 +1841,23 @@ static void vg_diag_os(void)
 		dbgprintf("DIAG: os thr %u @%08X state %u prio %u waitq %08X | srr0 %08X lr %08X r1 %08X srr1 %08X\r\n", n, t, st, pr, q, pc, lr, r1, msr);
 		t = vg_pm_rd(t + 0x2FCu);
 	}
+	vg_diag_pc();
+}
+/* where the PowerPC was when the OS interrupt dispatcher last ran (FakeInterrupt.S stores it uncached, 4 entries, newest = counter & 3).  The IPC interrupt is re-thrown every 8 ms while EXI_INT is set and VI retraces come
+   60 times a second, so a thread that is spinning with interrupts on shows its real PC here; a counter that does not move means no interrupt reaches the dispatcher (interrupts off or the PowerPC gone). */
+static u32 vgPcLast;
+static void vg_diag_pc(void)
+{
+	const volatile u32 *b = (const volatile u32 *)0x13026700;
+	u32 ctr, k;
+	sync_before_read((void *)0x13026700, 0xA0);
+	ctr = b[0];
+	dbgprintf("DIAG: ppc interrupt samples: counter %u (+%u since the last dump)\r\n", ctr, ctr - vgPcLast);
+	vgPcLast = ctr;
+	for (k = 0; k < 4u && ctr; k++) {
+		u32 i = (ctr - k) & 3u; const volatile u32 *e = b + 8 + 8 * i;
+		dbgprintf("DIAG: ppc sample -%u: srr0 %08X srr1 %08X lr %08X r1 %08X | PI intsr %08X intmr %08X | os mask %08X\r\n", k, e[0], e[1], e[2], e[3], e[4], e[5], e[6]);
+	}
 }
 static void vg_diag_ppc(void)
 {
@@ -2104,7 +2126,7 @@ void VBBAUpdate(void)
 		if (vgCfgNetDelayS) { if (ms >= vgCfgNetDelayS * 1000u) { vgNetReleased = true; if (vgCfgNetEarly) dbgprintf("VBBA: net start released EARLY at %u ms (netearly %u s, SD ops %u)\r\n", ms, vgCfgNetDelayS, ops); else dbgprintf("VBBA: net start released at %u ms (netdelay %u s)\r\n", ms, vgCfgNetDelayS); } }
 		else if (VBBA_NET_DELAY_S) { if (ms >= (u32)VBBA_NET_DELAY_S * 1000u) { vgNetReleased = true; dbgprintf("VBBA: net start released at %u ms\r\n", ms); } }
 		else if (ms >= (u32)VBBA_NET_CAP_S * 1000u) { vgNetReleased = true; dbgprintf("VBBA: net start released: cap reached at %u ms (SD ops %u)\r\n", ms, ops); }
-		else if (ms >= (u32)VBBA_NET_MIN_S * 1000u && (u32)(ms - last_chg) >= (u32)VBBA_NET_IDLE_S * 1000u) { vgNetReleased = true; dbgprintf("VBBA: net start released: SD idle for %u s at %u ms (SD ops %u)\r\n", (u32)VBBA_NET_IDLE_S, ms, ops); }
+		else if (ms >= (u32)VBBA_NET_MIN_S * 1000u && (u32)(ms - last_chg) >= (u32)VBBA_NET_IDLE_S * 1000u && (!vgCfgGate || (vgRegCnt[VGR_RESPONSE] && vgRegCnt[VGR_SR_ON] && vgRegLastTick && (u32)(read32(HW_TIMER) - vgRegLastTick) >= 3u * 1898000u))) { vgNetReleased = true; dbgprintf("VBBA: net start released: SD idle for %u s at %u ms (SD ops %u)%s\r\n", (u32)VBBA_NET_IDLE_S, ms, ops, vgCfgGate ? ", guest BBA init done (gate)" : ""); }
 	}
 	MS_ST(MSS_VREOPEN);
 	vg_reopen();                                        /* missing handles / ncd: blocking opens belong here, not on the fast thread */
