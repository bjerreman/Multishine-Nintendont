+/* (diagnostic only, reads only): the PowerPC OS thread list.  Interrupts keep running in the frozen runs (the VI retrace counter moves in lumps) but scene_frames stops and the guest posts no more EXI
+   commands, so a game thread is blocked or spinning.  OS globals (Dolphin SDK): 0x800000D4 current OSContext*, 0x800000DC / 0x800000E0 head / tail of the active thread list, 0x800000E4 current OSThread*.
+   OSThread: context 0x000 (r1 at +0x04, lr +0x84, srr0 +0x198, srr1 +0x19C), state u16 +0x2C8 (1 ready, 2 running, 4 waiting, 8 moribund), priority +0x2D0, wait queue +0x2DC, active-list next +0x2FC.
+   A WAITING thread (state 4) with a wait queue is blocked on a lost completion (lr/srr0 name the call site); a RUNNING / READY one with the same srr0 on consecutive samples spins.  The saved context can be stale
+   (a running thread's context is only written at a switch) and PowerPC stores can sit in its data cache, so the same line twice in a row is the useful signal. */
+static u32 vg_pm_ok(u32 a) { return a >= 0x80000000u && a < 0x81800000u && !(a & 3u); }
+static u32 vg_pm_rd(u32 a) { if (!vg_pm_ok(a)) return 0; sync_before_read((void *)((u32)VG_PM(a) & ~31u), 0x20); return *VG_PM(a); }
+static void vg_diag_os(void)
+{
+	u32 cur_ctx, head, curthr, t, n;
+	sync_before_read((void *)VG_PM(0x800000C0u), 0x40);
+	cur_ctx = VG_PM(0x800000D4u)[0]; head = VG_PM(0x800000DCu)[0]; curthr = VG_PM(0x800000E4u)[0];
+	dbgprintf("DIAG: os cur ctx %08X cur thread %08X active list head %08X tail %08X | exi cause words %08X %08X %08X\r\n", cur_ctx, curthr, head, VG_PM(0x800000E0u)[0], vg_pm_rd(0x80000010u), vg_pm_rd(0x80000014u), vg_pm_rd(0x80000018u));
+	for (t = head, n = 0; vg_pm_ok(t) && n < 8u; n++) {
+		u32 st, pr, q, r1, lr, pc, msr;
+		sync_before_read((void *)((u32)VG_PM(t + 0x2C8u) & ~31u), 0x40);
+		st = vg_pm_rd(t + 0x2C8u) >> 16; pr = vg_pm_rd(t + 0x2D0u); q = vg_pm_rd(t + 0x2DCu);
+		r1 = vg_pm_rd(t + 0x04u); lr = vg_pm_rd(t + 0x84u); pc = vg_pm_rd(t + 0x198u); msr = vg_pm_rd(t + 0x19Cu);
+		dbgprintf("DIAG: os thr %u @%08X state %u prio %u waitq %08X | srr0 %08X lr %08X r1 %08X srr1 %08X\r\n", n, t, st, pr, q, pc, lr, r1, msr);
+		t = vg_pm_rd(t + 0x2FCu);
+	}
+}
