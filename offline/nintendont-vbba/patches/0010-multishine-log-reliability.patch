@@ -1761,8 +1761,11 @@
 		dbgprintf("DIAG: guest tx frame #%u at %u ms: eth %04X proto %u dst %u.%u.%u.%u port %u src port %u arp op %u len %u\r\n", printed, vg_now_ms(NULL), h->eth, h->proto, d >> 24, (d >> 16) & 255u, (d >> 8) & 255u, d & 255u, h->dport, h->sport, h->op, h->len);
