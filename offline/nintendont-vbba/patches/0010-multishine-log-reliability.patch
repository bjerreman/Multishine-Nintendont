@@ -170,6 +170,8 @@
 #endif
 
 #endif
+	dbgprintf("LOGEND: shutdown request handled, log closed\r\n");   /* the vBBA stopped block (EXIShutdown above) and this line are synced by dbgprintf; the close finishes the file */
