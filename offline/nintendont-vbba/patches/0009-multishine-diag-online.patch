+/* the guest's online state, read from the ARM at build-fixed addresses (no scan): the engine's own status blocks (s3_status, od_st, on_st, onc_st).  The addresses change with every engine build:
+   they are generated into kernel/vbba_online.h by build_wii.sh from the build's image.json and are valid for ONE release only (VBBA_ONL_REL / VBBA_ONL_BUILD).  The three magic words that the image carries from the start (S3ST, ONST, ONCF; od_st has none) are read first;
+   any mismatch prints 'addr mismatch' and nothing else.  od_st has no cfg_ok / net_up words: srv_ip != 0 means od_apply_config ran with the card record, net_ip != 0 means the guest has its address;
+   on_st.cfg_loads counts card config loads that filled od_cfg. */
+#if VBBA_ONL
+static void vg_diag_online(u32 k, u32 tl, u32 sec)
+{
+	const volatile u32 *s3 = VG_PM(VBBA_ONL_S3), *od = VG_PM(VBBA_ONL_OD), *on = VG_PM(VBBA_ONL_ON), *onc = VG_PM(VBBA_ONL_ONC);
+	sync_before_read((void *)((u32)s3 & ~31u), 0x120);
+	sync_before_read((void *)((u32)od & ~31u), 0x120);
+	sync_before_read((void *)((u32)on & ~31u), 0x60);
+	sync_before_read((void *)((u32)onc & ~31u), 0x60);
+	if (s3[0] != 0x53335354u || on[0] != 0x4F4E5354u || onc[0] != 0x4F4E4346u) {      /* the three blocks with a compiled-in magic (od_st has none: it is zero until written) */
+		if (k == 0) dbgprintf("DIAG: online addr mismatch: s3 %08X on %08X onc %08X (addresses valid for release %s build %s only)\r\n", s3[0], on[0], onc[0], VBBA_ONL_REL, VBBA_ONL_BUILD);
+		return;
+	}
+	if (k == 0) {
+		if (tl) dbgprintf("VBBA: tl@%u online s3: state %X calls %u spin %u ip %08X tx_fail %u slice_skip %u\r\n", sec, s3[1], s3[3], s3[39], s3[4], s3[27], s3[47]);
+		else dbgprintf("DIAG: online s3: state %X calls %u spin %u ip %08X tx_fail %u slice_skip %u (release %s)\r\n", s3[1], s3[3], s3[39], s3[4], s3[27], s3[47], VBBA_ONL_REL);
+	} else if (k == 1) {
+		if (tl) dbgprintf("VBBA: tl@%u online od: phase %u err %u cfg_why %u srv_ip %08X net_ip %08X dns %u b9 %u\r\n", sec, od[1], od[2], od[45], od[56], od[19], od[48], od[24]);
+		else dbgprintf("DIAG: online od: phase %u err %u cfg_why %u srv_ip %08X net_ip %08X dns %u b9 %u\r\n", od[1], od[2], od[45], od[56], od[19], od[48], od[24]);
+	} else {
+		if (tl) dbgprintf("VBBA: tl@%u online on: cfg_loads %u | onc tries %u why %u done %u verdict %X slot %u res %08X set_sv %X\r\n", sec, on[14], onc[1], onc[2], onc[6], onc[3], onc[4], onc[5], onc[11]);
+		else dbgprintf("DIAG: online on: cfg_loads %u | onc tries %u why %u done %u verdict %X slot %u res %08X set_sv %X\r\n", on[14], onc[1], onc[2], onc[6], onc[3], onc[4], onc[5], onc[11]);
+	}
+}
+#else
+static void vg_diag_online(u32 k, u32 tl, u32 sec) { (void)k; (void)tl; (void)sec; }
+#endif
 /* the first (up to 8) distinct frame headers the guest transmitted, each printed once, as soon as the main thread sees them */
 static void vg_diag_txhdr(void)
 {
@@ -1742,7 +1776,7 @@
 		exiServed[0][2] - pS[0][2], exiServed[1][2] - pS[1][2], exiServed[2][2] - pS[2][2]);
 	dbgprintf("DIAG: 10s bba cmds sel +%u (%u) imm +%u (%u) dma +%u (%u) | blocked +%u (%u)\r\n",
 		exiServedBba[0] - pB[0], exiServedBba[0], exiServedBba[1] - pB[1], exiServedBba[1], exiServedBba[2] - pB[2], exiServedBba[2], exiDiagBlocked - pBl, exiDiagBlocked);
-	vg_diag_net(0, 0, 0); vg_diag_net(1, 0, 0);
+	vg_diag_net(0, 0, 0); vg_diag_net(1, 0, 0); vg_diag_net(2, 0, 0); vg_diag_online(0, 0, 0); vg_diag_online(1, 0, 0); vg_diag_online(2, 0, 0);
 	ev[0] = vgRegCnt[VGR_NCRA_RST_ON]; ev[1] = vgRegCnt[VGR_SR_ON]; ev[2] = vgRegCnt[VGR_NWAYC] + vgRegCnt[VGR_SIACTRL2]; ev[3] = vgRegCnt[VGR_DEVID] + vgRegCnt[VGR_ACSTART] + vgRegCnt[VGR_RESPONSE]; ev[4] = vgRegCnt[VGR_IMR];
 	evd = 0; for (d = 0; d < 5u; d++) evd += ev[d] - pEv[d];
 	dbgprintf("DIAG: 10s guest %s | vi %u (+%u) scene_frames %u (+%u) hook_calls %u (+%u)\r\n",
@@ -1880,7 +1914,7 @@
 	{ u32 d = (u32)(now - vgTlTick) / 1898u; vgTlTick += d * 1898u; vgTlMs += d; }     /* whole ms (HW_TIMER 1.898 MHz) */
 	if (vgTlK >= VG_TL_LINES && vgTlMs >= vgTlNext) { vgTlK = 0; vgNetLn = 0; vgTlNext = vgTlMs + VBBA_TL_PERIOD_MS; vgTlAt = vgTlMs / 1000u; }
 	if (vgTlK < VG_TL_LINES && !DI_IRQ && !vgHold) { vg_tl_line(vgTlK++, vgTlAt); last_tick = read32(HW_TIMER); }
-	else if (vgTlK >= VG_TL_LINES && vgNetLn < 2u && !DI_IRQ && !vgHold) { vg_diag_net(vgNetLn++, 1, vgTlAt); last_tick = read32(HW_TIMER); }
+	else if (vgTlK >= VG_TL_LINES && vgNetLn < 6u && !DI_IRQ && !vgHold) { if (vgNetLn < 3u) vg_diag_net(vgNetLn, 1, vgTlAt); else vg_diag_online(vgNetLn - 3u, 1, vgTlAt); vgNetLn++; last_tick = read32(HW_TIMER); }
 }
 
 void VBBAShutdown(void)
diff --git a/kernel/vbba_online.h b/kernel/vbba_online.h
new file mode 100644
--- /dev/null
+++ b/kernel/vbba_online.h
@@ -0,0 +1,12 @@
+/* generated by offline/nintendont-vbba/build_wii.sh from the engine build's image.json (NIN_MS_ONLINE_INFO); this default has the online DIAG lines OFF.
+   The addresses are guest virtual addresses (0x817xxxxx) of struct s3_status (status_addr), od_status (od_status_addr), on_status (on_status_addr), onc_status (onc_status_addr). */
+#ifndef VBBA_ONLINE_H
+#define VBBA_ONLINE_H
+#define VBBA_ONL 0
+#define VBBA_ONL_S3 0u
+#define VBBA_ONL_OD 0u
+#define VBBA_ONL_ON 0u
+#define VBBA_ONL_ONC 0u
+#define VBBA_ONL_REL "none"
+#define VBBA_ONL_BUILD "none"
+#endif
