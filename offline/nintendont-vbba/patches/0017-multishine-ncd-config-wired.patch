+#ifndef VBBA_WIRED
+#define VBBA_WIRED 1        /* read the stored network config through ncd (ioctlv 3), log which connection / interface kind IOS will use, ask ip/top for the interface MAC again later (logged with the time); read-only, nothing is written to the Wii's network config */
+#endif
+static u32 vgCfgKind;                        /* header byte 4 of the ncd config after the read: 1 wireless, 2 wired, 0 unknown */
+static u32 vgIfMacT1, vgIfMacTries;           /* time (ms) of the first ip/top MAC answer, and how many later main-thread queries were made */
