@@ -1915,11 +1928,33 @@
 extern u32 dbgLogErrs, dbgLogBytes, dbgLogOpenErr;   /* kernel/vsprintf.c */
 extern u32 dbgBitN, dbgBitVal, dbgBitTick, dbgBitLast;   /* kernel/vsprintf.c, */
 extern vu32 vbbaSdErrN, vbbaSdErrRet, vbbaSdErrCmd, vbbaSdErrTick, vbbaSdWrRetry, vbbaSdWrFail;   /* kernel/SDI.c, */
+/* /vbba.cfg sdprobe=1.  Once a second the main loop reads SD sector 0 straight through the SD driver (no FatFs, a 32 byte aligned static buffer, so no shared buffer) and times it.
+   An SD request that never completes keeps the main loop here (stage MSS_PROBE, an SD stage): the watchdog shows it as a solid slot LED; a probe that failed or took over 500 ms makes the LED blink fast.
+   Skipped while an asynchronous disc read may be using the SD (DI_IRQ). */
+static u8 vgProbeBuf[512] __attribute__((aligned(32)));
+void VBBASdProbeTick(void)
+{
+	static u32 next;
+	u32 t = read32(HW_TIMER), t1;
+	bool ok;
+	if (!vbbaCfgSdProbe || DI_IRQ || (u32)(t - next) < 1898000u) return;
+	next = t;
+	MS_ST(MSS_PROBE);
+	vbbaPrBusy = t | 1u;
+	ok = sdio_ReadSectors(0, 1, vgProbeBuf);
+	t1 = read32(HW_TIMER);
+	vbbaPrBusy = 0;
+	vbbaPrN++; vbbaPrLast = t1 - t; if (vbbaPrLast > vbbaPrMax) vbbaPrMax = vbbaPrLast;
+	if (ok) vbbaPrOk++; else if (!vbbaPrFail++) vbbaPrFailTick = t1;
+	vbbaPrBad = (!ok || vbbaPrLast > 949000u) ? 1u : 0u;
+	MS_ST(MSS_TOP);
+}
 static void vg_diag_10s(u32 t)
 {
 	static u32 logok;
 	dbgprintf("LOGOK %u errs %u open_err %u bytes %u\r\n", ++logok, dbgLogErrs, dbgLogOpenErr, dbgLogBytes);
 	dbgprintf("SDERR: cmd errs %u first %d cmd %u @%u | wr retry %u fail %u | bit0 clr %u v %X @%u last %u now %u\r\n", vbbaSdErrN, (int)vbbaSdErrRet, vbbaSdErrCmd, vbbaSdErrTick, vbbaSdWrRetry, vbbaSdWrFail, dbgBitN, dbgBitVal, dbgBitTick, dbgBitLast, read32(HW_TIMER));
+	if (vbbaCfgSdProbe || vbbaCfgNoSave) dbgprintf("SDPROBE: n %u ok %u fail %u first fail @%u | last %u max %u ms | pending %u ms | nosave skipped %u last @%u now %u\r\n", vbbaPrN, vbbaPrOk, vbbaPrFail, vbbaPrFailTick, vbbaPrLast / 1898u, vbbaPrMax / 1898u, vbbaPrBusy ? (u32)(read32(HW_TIMER) - (vbbaPrBusy & ~1u)) / 1898u : 0u, vbbaNoSaveN, vbbaNoSaveTick, read32(HW_TIMER));   /* */
 	dbgprintf("STALLMAX: longest %u ms at stage %u, now stage %u age %u ms, watchdog beats %u, entries %u\r\n", msCrumb.maxms, msCrumb.maxstage, msCrumb.stage, (u32)(read32(HW_TIMER) - msCrumb.t) / 1898u, msCrumb.wdbeat, msCrumb.n);   /* */   /* a run that ends abruptly has its last LOGOK; a stale file has none */
 	static u32 pt, pS[4][3], pB[4], pBl, pVi, pSf, pHook, pEv[VGR_N], pBbaD; static bool init;
 	u32 c, d, ms = pt ? (t - pt) / 1898u : 0, s3 = vg_dg_find_s3(), hook = 0, vi, sf, bba = 0, bbad, ev[VGR_N], evd;
